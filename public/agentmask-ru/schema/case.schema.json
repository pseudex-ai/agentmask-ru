{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "AgentMask-RU case",
 "description": "Один случай: короткий русский диалог с персональными данными и инструмент, который агент должен вызвать. Нормативный файл — src/agentmask_ru/schema.py; расхождение разрешается в пользу него.",
 "type": "object",
 "required": [
  "id",
  "version",
  "family",
  "register",
  "subcase",
  "messages",
  "tools",
  "expected_call",
  "pii",
  "negatives",
  "hard",
  "created_at",
  "source",
  "canary",
  "license"
 ],
 "additionalProperties": false,
 "properties": {
  "id": {
   "type": "string",
   "minLength": 1
  },
  "version": {
   "type": "string"
  },
  "family": {
