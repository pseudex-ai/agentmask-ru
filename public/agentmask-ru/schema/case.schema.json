     "turn": {
      "type": "integer"
     },
     "start": {
      "type": "integer"
     },
     "end": {
      "type": "integer"
     }
    }
   }
  },
  "hard": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "why"
     ],
     "properties": {
      "why": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "created_at": {
   "type": "string"
  },
  "source": {
   "type": "object",
   "required": [
    "generator",
    "version",
    "seed"
   ],
   "additionalProperties": false,
   "properties": {
    "generator": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "seed": {
     "oneOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "canary": {
   "const": "AGENTMASK-RU-CANARY-7c1e4b2a-6f3d-4a8e-9b1c-2d5e8f0a3b7c"
  },
  "license": {
   "const": "CC-BY-4.0"
  }
 }
}
