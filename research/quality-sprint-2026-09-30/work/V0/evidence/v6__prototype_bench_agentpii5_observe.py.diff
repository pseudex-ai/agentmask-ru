+def _ipv6_spans(needle: str, text: str) -> list[tuple[int, int]]:
+    """Where the IPv6 address `needle` stands in `text`, comparing the ADDRESS
+    not the string (tz-agentpii6.md §1.0): «2001:0db8:…:0001» and «2001:db8::1»
