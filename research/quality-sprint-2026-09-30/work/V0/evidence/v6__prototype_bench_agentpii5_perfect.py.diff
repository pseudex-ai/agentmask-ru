+        if shift % 10 == 0:
+            continue
+        made = [_shift_text(text, shift) for text in texts]
+        if not all(_grammar_holds(spec, one) for one in made):
+            continue
+        if spec.generated_checksum and _v6_checksum_valid(spec, made[0]):
+            continue
