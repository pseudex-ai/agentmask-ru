{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "last-release-sha": "ff6245c795ad6599af45824d88a1b9ba3e3e2515",
  "release-type": "simple",
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore(release): ${component} ${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Новое"
    },
    {
      "type": "fix",
      "section": "Исправления"
    },
    {
      "type": "security",
      "section": "Безопасность"
    },
    {
      "type": "perf",
      "section": "Производительность"
    },
    {
      "type": "build",
      "section": "Сборка"
    },
    {
      "type": "revert",
      "section": "Откаты"
    },
    {
      "type": "chore",
      "section": "Прочее",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Документация",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Рефакторинг",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Тесты",
      "hidden": true
    },
    {
      "type": "research",
      "section": "Исследования",
      "hidden": true
    },
    {
      "type": "bench",
      "section": "Бенчмарки",
      "hidden": true
    }
  ],
  "packages": {
    "prototype": {
      "component": "engine",
      "include-component-in-tag": false,
      "exclude-paths": [
        "prototype/licensing",
        "prototype/bench",
        "prototype/e2e"
      ],
      "changelog-path": "CHANGELOG.md"
    }
  }
}
