# Pseudex sidecar — RELEASE image. The engine as a native binary.
#
#   docker build -f Dockerfile.nuitka --build-arg PSEUDEX_LICENSE_PUBKEY=... \
#                -t pseudex:compiled .
#
# Nuitka translates Python to C and compiles it, so there is no bytecode to
# decompile. That raises the cost of reading the engine from minutes to weeks —
# it does not make it impossible, and the honest planning assumption is that it
# is a delay, not a wall. The real protection is that the engine is EMPTY: the
# gazetteers, street vocabulary and priority table are leased at runtime and
# exist only in memory. A perfectly reverse-engineered binary still cannot detect
# anything without a lease that we can stop renewing.
#
# NOT --onefile: it unpacks itself into a temp directory on every start, which is
# both slower and the very thing we avoid — assets and code materialising on the
# customer's disk. --standalone keeps a plain directory inside the image.

# BOTH STAGES ARE PINNED TO THE SAME DEBIAN RELEASE, and that is not cosmetic.
# A Nuitka binary links against the build stage's glibc, so a runtime with an
# older one refuses to start:
#   /app/pseudex-serve: /lib/aarch64-linux-gnu/libc.so.6: version `GLIBC_2.38' not found
# That is exactly what happened with `python:3.12-slim` (which had moved on to
# trixie, glibc 2.41) over `debian:12-slim` (bookworm, glibc 2.36) — the floating
# tag silently changed underneath a pinned one. Change these two together or not
# at all.
FROM python:3.12-slim-trixie AS build

# patchelf is required by Nuitka standalone to fix up the RPATHs of the bundled
# shared objects (pyrage, cryptography and sqlcipher3 are compiled extensions).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential patchelf ccache \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY requirements.txt .
# Attribution for the CC BY-SA 3.0 dictionary data. Shipping it is the
# obligation the licence actually imposes — see the file for why it does
# not make the product itself share-alike.
COPY THIRD-PARTY-NOTICES.md .
RUN pip install --no-cache-dir --upgrade pip setuptools \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir nuitka

COPY pseudex/ ./pseudex/
COPY serve_main.py build_strip_docstrings.py build_harden_strings.py ./


# Same guard as the source image, before anything is compiled: the engine must
# not be able to reach the package that holds the assets.
RUN if [ -d ./pseudex/data ]; then echo "pseudex/data must not ship"; exit 1; fi
RUN if grep -rn "^[[:space:]]*\(from\|import\)[[:space:]]\+licensing" ./pseudex/; then \
        echo "pseudex/ must never import licensing/"; exit 1; \
    fi
RUN if grep -rn "^[[:space:]]*\(from\|import\)[[:space:]]\+sqlite3" ./pseudex/; then \
        echo "pseudex/ must reach SQLite only through sqlite_setup: stdlib sqlite3"; \
        echo "accepts PRAGMA key WITHOUT raising and writes plain text, so any"; \
        echo "import of it here is a product that claims encryption and has none"; \
        exit 1; \
    fi

# Baked before compilation, so the verification key ends up INSIDE the binary
# rather than in a file next to it.
ARG PSEUDEX_LICENSE_PUBKEY
RUN test -n "$PSEUDEX_LICENSE_PUBKEY" || (echo "PSEUDEX_LICENSE_PUBKEY build-arg is required" && exit 1) \
    && printf 'LICENSE_PUBKEY = "%s"\n' "$PSEUDEX_LICENSE_PUBKEY" > ./pseudex/_release.py

# pymorphy3's dictionaries and natasha's NER models are DATA inside third-party
# packages; Nuitka does not follow them unless told. They ship in the image on
# purpose — they are open artifacts, not our moat, so leasing them would buy
# nothing and cost startup time.
#
# `pymorphy3_dicts_ru` needs BOTH --include-package (its code) and
# --include-package-data (its .dawg files). pymorphy3 resolves it at runtime
# through an entry point, so static analysis never sees the import: with only the
# data flag the package arrives without its `__init__.py` and the binary dies at
# startup with `module 'pymorphy3_dicts_ru' has no attribute 'get_path'`.
#
# `sqlcipher3` is named explicitly for a different reason: the product imports
# `sqlcipher3.dbapi2`, and the package's `_sqlite3.so` is what actually holds
# SQLCipher. There is no fallback to stdlib `sqlite3` anywhere in the engine, on
# purpose — stdlib accepts `PRAGMA key` without raising and writes plain text —
# so a binary that failed to bundle this one would not degrade, it would refuse
# to start, which is the correct failure but a slow one to diagnose in a release.
#
# Docstrings out BEFORE compilation. `--python-flag=no_docstrings` (passed below)
# only stops the compiled module from setting `__doc__` — the literals still land
# in Nuitka's constants blob, where `grep -a` finds them verbatim. Measured on a
# built image: "Connector to the leased asset state" and friends, present.
#
# They matter more than the code. This repo's docstrings ARE the design record:
# which alternative was rejected, what was measured, where the sharp edges are.
# Shipping them means handing over the reasoning and withholding only syntax.
RUN python build_strip_docstrings.py ./pseudex ./serve_main.py

# Строки-маяки лицензионного тракта — из бинарника. Замерено: Nuitka кладёт
# литералы в constants-блоб открытым текстом, и `grep license_expired` ведёт
# любителя прямо к ветке деградации. Пасс заменяет их на выражение с тем же
# значением в рантайме, но без исходной строки — контракт цел, `grep` слеп.
# Только на компилируемом образе: в dev-образе из .py это лишь портило бы логи.
# P2b (греп собранного образа) проверяет, что Nuitka не свернул их обратно.
RUN python build_harden_strings.py ./pseudex

ARG NUITKA_JOBS=6
# --include-data-dir puts the interface's page files at /app/ui, OUTSIDE any
# directory called `pseudex`. Gate P1 asserts /app/pseudex does not exist in
# the release image and uses that as evidence the Python package did not ship;
# --include-package-data=pseudex would recreate that tree for a few CSS files.
RUN python -m nuitka \
        --standalone \
        --assume-yes-for-downloads \
        --jobs=${NUITKA_JOBS} \
        --output-filename=pseudex-serve \
        --include-package=pseudex \
        --include-package=uvicorn \
        --include-package=fastapi \
        --include-package=pymorphy3_dicts_ru \
        --include-package-data=pymorphy3_dicts_ru \
        --include-package=sqlcipher3 \
        --include-package-data=natasha \
        --include-package-data=navec \
        --include-package-data=slovnet \
        --include-package-data=razdel \
        --include-package-data=yargy \
        --include-data-dir=./pseudex/localui/static=ui \
        --nofollow-import-to=tkinter \
        --nofollow-import-to=unittest \
        --nofollow-import-to=pydoc \
        --include-module=_json \
        --include-module=_bisect \
        serve_main.py

# `_json` and `_bisect` are forced back in because Nuitka's anti-bloat plugin
# drops them by default, and it says so only in a passing log line:
#   "Not including '_json' ... may slow down by using fallback implementation"
# `_json` is the C accelerator behind json.loads/dumps, and this service parses
# and re-serializes a JSON body on every single request — losing it trades a
# little image size for a permanent latency tax on the hot path.

# Runtime carries no Python at all: the standalone build brings its own libpython.
# Must be the SAME Debian release as the build stage — see the note at the top.
FROM debian:trixie-slim

WORKDIR /app
COPY --from=build /src/serve_main.dist/ /app/
COPY entrypoint.sh /app/
RUN chmod +x /app/entrypoint.sh /app/pseudex-serve

# Same guarantee, re-checked on the RUNTIME layer because this is the image that
# actually ships: no detection assets on disk, ever.
RUN if [ -d /app/pseudex/data ]; then echo "pseudex/data must not ship"; exit 1; fi

ENV PSEUDEX_DB_DIR=/data
RUN mkdir -p /data

# THE RUNTIME HAS NO UTF-8 STDIO OF ITS OWN, and the product speaks Russian.
# `debian:trixie-slim` sets no locale, and a Nuitka-frozen runtime does not
# perform CPython's locale coercion, so `print()` of a Cyrillic string died with
# `UnicodeEncodeError: 'ascii' codec` and `logging` fell back to escapes:
#   INFO:pseudex.localui:  pseudex \u2014 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439
# That was the operator's own sign-in banner, unreadable in the RELEASE image and
# fine in the source one — which is why nothing caught it: the two images differ
# in their base, and only one of them ships. `LANG=C.UTF-8` alone is NOT enough
# here; measured, the Cyrillic line still failed with it set.
ENV LANG=C.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    PSEUDEX_WORKERS="" \
    PSEUDEX_MASK_CONCURRENCY=8 \
    PSEUDEX_MASK_CACHE_SIZE=20000 \
    PSEUDEX_UI_STATIC=/app/ui \
    PSEUDEX_SERVE_CMD="/app/pseudex-serve"

# 8000 is the gateway the customer's own code calls; 8081 is the operator's
# interface and should be reachable from far fewer places. Two ports so that
# distinction is one firewall rule rather than a path prefix nobody enforces.
EXPOSE 8000 8081

# Run as a NON-ROOT user — the release image that actually ships. The tuning is
# decrypted in worker RAM; a non-root process's memory is unreadable to a
# co-located non-root or default-caps process, raising the RAM-extraction bar
# kernel-independently (pentest 2026-09-14). `mlockall` still takes as non-root
# given the container's memlock ulimit (`ulimits: { memlock: -1 }`). A fresh
# named volume at /data inherits this ownership; a pre-existing root-owned volume
# must be chowned once.
RUN groupadd -r pseudex && useradd -r -g pseudex -u 10001 -d /app pseudex \
    && chown -R pseudex:pseudex /data
USER pseudex

CMD ["./entrypoint.sh"]
