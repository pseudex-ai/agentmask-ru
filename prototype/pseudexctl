import urllib.request

DEFAULT_CONTAINER = "pseudex"
DEFAULT_IMAGE = "cr.yandex/pseudex/pseudex:latest"
DEFAULT_VOLUME = "pseudex-data"
DEFAULT_URL = "http://127.0.0.1:8000"

# Имена, значения которых не печатаются НИКОГДА. Список поимённый по той же
# причине, по которой поимённый список в `_passthrough_env`: шаблон однажды
# промахнётся мимо нового имени, и это будет заметно только по чужому логу.
_SECRET_NAMES = ("PSEUDEX_VAULT_KEY", "PSEUDEX_VAULT_KEY_NEW",
                 "PSEUDEX_ADMIN_TOKEN", "PSEUDEX_GATEWAY_TOKEN",
                 "PSEUDEX_LICENSE_KEY")


def _safe(args: list[str]) -> list[str]:
    """То, что печатается, — не то, что выполняется, и разница только в секретах.

    `--dry-run` и `-v` печатали argv целиком, а в нём стояло
    `-e PSEUDEX_VAULT_KEY=<ключ>`: инструмент, который просят показать команду
    ПЕРЕД выполнением, показывал ключ от волта — в терминал, в историю, в тикет
    поддержки, куда вывод и вставляют.
    """
    out = []
    for arg in args:
        name = arg.split("=", 1)[0]
        if "=" in arg and name in _SECRET_NAMES:
            out.append(f"{name}=***")
        else:
            # ЦИТИРУЕТСЯ, ПОТОМУ ЧТО ЭТУ СТРОКУ КОПИРУЮТ. Аргумент с пробелом или
            # точкой с запятой выполняется как ОДИН элемент argv, но напечатанный
            # без кавычек выглядит как две команды — и вставленный в терминал
            # ими же и станет.
            out.append(shlex.quote(arg))
    return out


OK, WARN, BAD = "ok", "warn", "bad"
_MARK = {OK: "  ok  ", WARN: " ВНИМ ", BAD: " ОТКАЗ"}


class Runner:
    """Всё, что уходит наружу, проходит через один объект.

    Не ради абстракции: так `--dry-run` печатает РОВНО ту команду, которая
    выполнилась бы, а проверки гоняют логику вердиктов без docker вообще. Тул,
    который нельзя проверить без боевого контейнера, не проверяется никогда.
    """

    def __init__(self, dry_run: bool = False, verbose: bool = False) -> None:
        self.dry_run = dry_run
        self.verbose = verbose

    def docker(self, args: list[str], timeout: int = 600) -> tuple[int, str]:
        if self.dry_run or self.verbose:
            print("+ docker " + " ".join(_safe(args)), file=sys.stderr)
        if self.dry_run:
            return 0, ""
        try:
            done = subprocess.run(["docker", *args], capture_output=True,
                                  text=True, timeout=timeout)
        except FileNotFoundError:
            return 127, "docker не найден в PATH"
        except PermissionError:
            return 126, "docker есть, но не запускается — права на сокет?"
        except subprocess.TimeoutExpired:
            return 124, f"docker не ответил за {timeout} с"
        return done.returncode, done.stdout + done.stderr

    def http(self, url: str, token: str, method: str = "GET",
             timeout: int = 30) -> tuple[int, str]:
        if self.dry_run or self.verbose:
            print(f"+ {method} {url}", file=sys.stderr)
        if self.dry_run:
            return 0, ""
        request = urllib.request.Request(url, method=method)
        if token:
            request.add_header("Authorization", f"Bearer {token}")
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                return response.status, response.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as error:
            return error.code, error.read().decode("utf-8", "replace")
        except OSError as error:
            return 0, str(error)


def _role(runner: Runner, role: str, image: str, volume: str,
          env: dict[str, str], extra: list[str] | None = None,
          read_only: bool = False) -> tuple[int, str]:
    """Одноразовая роль против ТОМА.

    СЕКРЕТ ПЕРЕДАЁТСЯ ИМЕНЕМ, А НЕ ЗНАЧЕНИЕМ. `-e ИМЯ` без `=` docker берёт из
    окружения ВЫЗЫВАЮЩЕГО, поэтому значение не появляется ни в argv, ни в `ps`
    на хосте, ни в истории команд. `-e ИМЯ=значение` кладёт ключ от волта во все
    три места сразу.

    СЕТЬ ОТКЛЮЧАЕТСЯ ТОЛЬКО КОГДА МОЖНО. `--network none` — правильная броня для
    ролей, которым ходить некуда, но `PSEUDEX_VAULT_KEY_CMD` — это команда,
    исполняемая ВНУТРИ контейнера, и у клиента это вызов менеджера секретов.
    Безусловная изоляция превращала здоровый том в «НЕ ОТКРЫВАЕТСЯ» после
    полутора минут ожидания — самый пугающий вердикт инструмента, выданный
    по причине, которую этот же инструмент и создал.
    """
    mount = f"{volume}:/data:ro" if read_only else f"{volume}:/data"
    args = ["run", "--rm", "-e", f"PSEUDEX_ROLE={role}",
            "-v", mount, "-e", "PSEUDEX_DB_DIR=/data"]
    if not env.get("PSEUDEX_VAULT_KEY_CMD"):
        args[1:1] = ["--network", "none"]
    for name, value in env.items():
        if not value:
            continue
        args += ["-e", name] if name in _SECRET_NAMES else ["-e", f"{name}={value}"]
    args += list(extra or [])
    args.append(image)
    return runner.docker(args)


def _passthrough_env() -> dict[str, str]:
    """Ключи волта берутся из окружения оператора и НЕ печатаются.

    Именно поэтому они перечислены поимённо: список пропускаемого — это
    решение, а `-e` по шаблону однажды увезёт в контейнер что-нибудь ещё.
    """
    return {name: os.environ.get(name, "") for name in (
        "PSEUDEX_VAULT_KEY", "PSEUDEX_VAULT_KEY_FILE", "PSEUDEX_VAULT_KEY_CMD",
        "PSEUDEX_VAULT_KEY_NEW", "PSEUDEX_VAULT_ENCRYPTION")}


