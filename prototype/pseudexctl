def _running(runner: Runner, container: str) -> bool:
    code, output = runner.docker(
        ["inspect", "--format", "{{.State.Running}}", container], timeout=60)
    return code == 0 and output.strip() == "true"


def _archive_mount(path: str, mode: str) -> tuple[list[str], str]:
    """Каталог монтируется, ИМЯ ФАЙЛА уезжает отдельным аргументом.

    Первая версия склеивала имя в строку `sh -c`, и это не теоретическая
    придирка: `restore "/tmp/vault backup.tgz"` выполнял `rm -rf /data/*`
    успешно, а распаковку — уже нет. Том стёрт, восстанавливать нечем. Форма с
    точкой с запятой в имени — та же дыра, только нарочно.

    Здесь нет ни одной подстановки в шелл: каталог идёт в `-v`, имя — отдельным
    элементом argv у `tar`, а всё, что должен сделать шелл, записано
    неизменяемой строкой.
    """
    directory = os.path.dirname(os.path.abspath(path)) or "."
    name = os.path.basename(path)
    # ПУСТОЕ ИМЯ — ЭТО ТОТ ЖЕ СТЁРТЫЙ ТОМ, ДРУГИМ ПУТЁМ. Путь, кончающийся на
    # слэш, даёт `basename == ""`; проверка на дефис и слэш его пропускала, а
    # `tar xzf "/archive/"` падает — уже ПОСЛЕ `rm -rf`. Найдено собственной
    # проверкой на инъекцию: `/tmp/x.tgz; rm -rf /` кончается слэшем.
    if not name or name.startswith("-") or "/" in name:
        raise ValueError(f"недопустимое имя файла: {path!r}")
    return ["-v", f"{directory}:/archive:{mode}"], name


def cmd_backup(args, runner: Runner) -> int:
    """Копия ТОМА, снятая отдельным контейнером.

    Не `docker cp` из работающего: SQLite пишет через WAL, и копия живого файла
    — это торн-пейдж, который ОТКРЫВАЕТСЯ и содержит не то. Поэтому движок
    проверяется ДО копирования, а не упоминается после: предупреждение,
    напечатанное под уже снятым архивом, — это описание испорченного файла,
    и восстанавливаться из него будут именно тогда, когда всё уже плохо.
    """
    try:
        mount, name = _archive_mount(args.file, "rw")
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 2
    if _running(runner, args.container) and not args.force:
        print(f"контейнер {args.container} работает. SQLite пишет через WAL, и "
              f"копия живой базы откроется, но будет содержать не то — а "
              f"восстанавливаться из неё будут в худший день.\n"
              f"Остановите движок (docker stop {args.container}) или повторите с "
              f"--force, если знаете, что трафика нет.", file=sys.stderr)
        return 2
    code, output = runner.docker([
        "run", "--rm", "--network", "none", "-v", f"{args.volume}:/data:ro",
        *mount, "--entrypoint", "tar", args.image,
        "czf", f"/archive/{name}", "-C", "/data", "."])
    print(output, end="")
    if code == 0 and not runner.dry_run:
        print(f"копия тома: {args.file}")
    return code


def cmd_restore(args, runner: Runner) -> int:
    if not args.yes:
        print("restore ПЕРЕЗАПИШЕТ том целиком. Повторите с --yes.", file=sys.stderr)
        return 2
    # ФАЙЛ ПРОВЕРЯЕТСЯ ДО СТИРАНИЯ, а не распаковкой после него. Порядок здесь
    # и есть вся разница: `rm -rf /data/*` выполняется первым и успешно, а
    # ошибка приходит от `tar` — том пуст, восстанавливать нечем, и всё это по
    # опечатке в имени.
    if not os.path.isfile(args.file):
        print(f"нет такого файла: {args.file}\nТом не тронут.", file=sys.stderr)
        return 2
    try:
        mount, name = _archive_mount(args.file, "ro")
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 2
    # ЖИВОЙ ДВИЖОК ПЕРЕЖИВЁТ ВОССТАНОВЛЕНИЕ И ОТМЕНИТ ЕГО. Воркеры продолжают
    # писать в отвязанные inode и затирают только что восстановленные файлы —
    # причём `rekey`, который делает МЕНЬШЕ, движок останавливает.
    if _running(runner, args.container):
        print(f"контейнер {args.container} работает. Восстановление сотрёт том, а "
              f"живые воркеры продолжат писать в отвязанные inode и затрут "
              f"восстановленное.\nСначала: docker stop {args.container}",
              file=sys.stderr)
        return 2
    code, output = runner.docker([
        "run", "--rm", "--network", "none", "-v", f"{args.volume}:/data",
        *mount, "-e", f"ARCHIVE={name}", "--entrypoint", "sh", args.image, "-c",
        # НИ ОДНОЙ ПОДСТАНОВКИ В КОМАНДУ: строка неизменяема, имя файла приходит
        # переменной окружения и раскрывается шеллом уже внутри контейнера, в
        # кавычках. Пробел в имени остаётся пробелом, точка с запятой — точкой с
        # запятой, а не второй командой, которая выполнится после `rm -rf`.
        'set -e; rm -rf /data/..?* /data/.[!.]* /data/*; '
        'tar xzf "/archive/$ARCHIVE" -C /data'],
        timeout=1800)
    print(output, end="")
    return code


