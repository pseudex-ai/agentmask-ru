def cmd_preflight(args, runner: Runner) -> int:
    # ВСЯ СЕМЬЯ РУЧЕК, А НЕ ОДНА. С одним PSEUDEX_WORKERS предполёт считал бюджет
    # по УМОЛЧАНИЯМ и отвечал про контейнер, которого у клиента нет: тот, кто
    # поднял PSEUDEX_WORKER_MB под свой трафик, получил бы чужую арифметику с
    # нашей интонацией уверенности.
    env = dict(_passthrough_env())
    for name in ("PSEUDEX_WORKERS", "PSEUDEX_WORKER_MB", "PSEUDEX_HEADROOM_MB",
                 "PSEUDEX_UI", "PSEUDEX_MEMORY_LIMIT_MB"):
        env[name] = os.environ.get(name, "")
    code, output = _role(runner, "preflight", args.image, args.volume, env,
                         extra=([f"--memory={args.memory}"] if args.memory else []))
    print(output, end="")
    return code


