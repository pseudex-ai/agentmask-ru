def _wait_healthy(runner: Runner, url: str, seconds: int = 180) -> bool:
    """Дождаться, пока движок отвечает. Каждый стенд в этом репозитории так и
    делает, и не от вежливости: контейнер строит модель и берёт аренду, а запрос
    в эту секунду получает connection refused. Проверка, спрашивающая слишком
    рано, объявляет отказом собственное нетерпение."""
    if runner.dry_run:
        return True
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        status, _body = runner.http(f"{url}/health", "", timeout=5)
        if status == 200:
            return True
        time.sleep(3)
    return False


def _restart_plan(args) -> tuple[bool, str]:
    """Можно ли поднять ТОТ ЖЕ контейнер, или его надо пересоздать.

    `docker start` ВОСПРОИЗВОДИТ ОКРУЖЕНИЕ, С КОТОРЫМ КОНТЕЙНЕР СОЗДАВАЛИ. Если
    ключ задан литералом в `PSEUDEX_VAULT_KEY`, то после ротации этот контейнер
    поднимется со СТАРЫМ ключом и не откроет собственный том — а инструмент,
    запустивший его и напечатавший «движок запущен», соврал бы в самый
    неподходящий момент.

    Если ключ приходит из `_FILE` или `_CMD`, он разрешается ПРИ СТАРТЕ и вне
    окружения контейнера — тогда `docker start` верен, и это самый частый случай
    у тех, кто вообще вращает ключи.
    """
    if args.start_cmd:
        return True, args.start_cmd
    if os.environ.get("PSEUDEX_VAULT_KEY"):
        return False, ""
    return True, f"docker start {args.container}"


def cmd_rekey(args, runner: Runner) -> int:
    """Ротация ключа, и — по просьбе — ДОКАЗАТЕЛЬСТВО, что она ничего не сломала.

    ЭТОГО НЕ ПРОВЕРЯЛ НИКТО. `vault_migrate.rekey_store` доказывает ровно одно:
    файл открывается новым ключом. Что подстановки, уже лежащие в CRM клиента,
    по-прежнему разворачиваются в настоящие значения, не проверял ни один гейт и
    ни один тест — а это и есть единственное, ради чего волт существует.

    Проверка устроена так, чтобы ничего не выдумывать: `/selfcheck` гоняет
    НАСТОЯЩИЕ /mask и /unmask на канонической фразе под своей организацией,
    которую биллинг исключает, и возвращает подстановки. Те же значения после
    ротации обязаны дать ТЕ ЖЕ подстановки — если строки пережили смену ключа.
    Разошлись — значит вместо старых строк отчеканены новые, и у половины людей
    в чужой системе теперь по два псевдонима.
    """
    can_restart, start_cmd = _restart_plan(args)
    before: dict[str, str] = {}
    if args.verify:
        if not can_restart:
            print("ключ задан литералом в PSEUDEX_VAULT_KEY, поэтому `docker start` "
                  "поднимет контейнер со СТАРЫМ ключом и он не откроет том.\n"
                  "Скажите, чем поднимать после ротации:\n"
                  "  pseudexctl rekey --verify --start-cmd 'docker compose up -d pseudex'\n"
                  "(в окружении этой команды PSEUDEX_VAULT_KEY должен быть уже НОВЫМ)",
                  file=sys.stderr)
            return 2
        status, body = runner.http(f"{args.url}/selfcheck", args.token, "POST", timeout=180)
        if status != 200 and not runner.dry_run:
            print(f"проверка невозможна: /selfcheck ответил {status}. Движок должен "
                  f"работать ДО ротации, иначе сравнивать не с чем.", file=sys.stderr)
            return 1
        before = _tokens(body)
        if not before and not runner.dry_run:
            print("проверка невозможна: /selfcheck не вернул ни одной подстановки",
                  file=sys.stderr)
            return 1
        print(f"до ротации: {len(before)} подстановок запомнено")

    # КОД ВОЗВРАТА `stop` НЕ ВЫБРАСЫВАЕТСЯ. Опечатка в `--container` означала бы
    # ротацию под живым движком — ровно то, чего `serve_main._rekey` не может
    # проконтролировать сам и о чём честно пишет в своём докстринге.
    code, output = runner.docker(["stop", args.container], timeout=180)
    if code != 0 and not runner.dry_run:
        print(f"не удалось остановить {args.container}: {output.strip()}\n"
              f"Ротация под живым движком подменяет файлы из-под работающих "
              f"воркеров — не начинаем.", file=sys.stderr)
        return 1

    code, output = _role(runner, "rekey", args.image, args.volume, _passthrough_env())
    print(output, end="")
    if code != 0:
        print("ротация НЕ ЗАВЕРШЕНА. Старый ключ НЕ выключайте — строки выше "
              "называют, какие файлы остались на нём.", file=sys.stderr)
        runner.docker(["start", args.container], timeout=180)
        return code

    started, start_output = runner.docker(shlex.split(start_cmd)[1:], timeout=180) \
        if start_cmd.startswith("docker ") else _shell(runner, start_cmd)
    if started != 0 and not runner.dry_run:
        print(f"ключ сменён, но поднять движок не удалось: {start_output.strip()}\n"
              f"Том уже на НОВОМ ключе — поднимайте с ним.", file=sys.stderr)
        return 1

    if not args.verify:
        print("движок запущен. Проверить, что детокенизация выжила: "
              "pseudexctl rekey --verify (или selfcheck)")
        return 0

    if not _wait_healthy(runner, args.url):
        print("ОТКАЗ: после ротации движок не поднялся за три минуты. Это не "
              "обязательно волт — смотрите docker logs.", file=sys.stderr)
        return 1
    status, body = runner.http(f"{args.url}/selfcheck", args.token, "POST", timeout=180)
    after = _tokens(body)
    if runner.dry_run:
        return 0
    return _verdict_after_rekey(before, after, status)


def _shell(runner: Runner, command: str) -> tuple[int, str]:
    """Команда подъёма, названная оператором, выполняется КАК ЕСТЬ.

    Это не дыра: строка приходит из его собственной командной строки, где он и
    так может выполнить что угодно. Зато `docker compose up -d pseudex` —
    единственный способ пересоздать контейнер с новым ключом, и не уметь его
    значило бы отправлять человека доделывать ротацию руками ровно в тот
    момент, когда важнее всего довести её до конца.
    """
    if runner.dry_run or runner.verbose:
        print(f"+ {command}", file=sys.stderr)
    if runner.dry_run:
        return 0, ""
    done = subprocess.run(command, shell=True, capture_output=True, text=True,
                          timeout=600)
    return done.returncode, done.stdout + done.stderr


def _tokens(body: str) -> dict[str, str]:
    """Подстановки из ответа /selfcheck, ключом — ЗНАЧЕНИЕ.

    Значения тут наши собственные, синтетические и захардкоженные в движке
    (`_SELFCHECK_TEXT`), так что держать их в памяти инструмента — не то же
    самое, что держать клиентские: у оператора на экране они и так есть.
    """
    try:
        data = json.loads(body or "{}")
    except ValueError:
        return {}
    return {str(span.get("value")): str(span.get("token"))
            for span in data.get("spans", []) if span.get("token")}


def _verdict_after_rekey(before: dict[str, str], after: dict[str, str],
                         status: int) -> int:
    if status != 200:
        print(f"ОТКАЗ: после ротации /selfcheck ответил {status}", file=sys.stderr)
        return 1
    moved = {value: (was, after.get(value)) for value, was in before.items()
             if after.get(value) != was}
    if moved:
        print("ОТКАЗ: после ротации подстановки СМЕНИЛИСЬ — значит строки не "
              "пережили смену ключа и отчеканены заново.", file=sys.stderr)
        for value, (was, now) in sorted(moved.items()):
            print(f"  было {was} -> стало {now}", file=sys.stderr)
        print("У людей, уже записанных в вашу систему под старыми подстановками, "
              "теперь по два псевдонима. Восстановите том из копии.", file=sys.stderr)
        return 1
    print(f"ротация завершена, детокенизация проверена: {len(before)} подстановок "
          f"разворачиваются в те же значения")
    return 0


# --- обновление ------------------------------------------------------------

def _inspect(runner: Runner, container: str) -> dict | None:
    """`docker inspect` одного контейнера как словарь, или None."""
    code, output = runner.docker(["inspect", container], timeout=60)
    if code != 0 or not output.strip():
        return None
    try:
        parsed = json.loads(output)
    except ValueError:
        return None
    return parsed[0] if isinstance(parsed, list) and parsed else None


def _image_env(runner: Runner, image: str) -> set[str]:
    code, output = runner.docker(["image", "inspect", "--format", "{{json .Config.Env}}", image],
                                 timeout=60)
    if code != 0:
        return set()
    try:
        return set(json.loads(output.strip() or "[]") or [])
    except ValueError:
        return set()


def _image_id(runner: Runner, reference: str) -> str:
    code, output = runner.docker(["image", "inspect", "--format", "{{.Id}}", reference], timeout=60)
    return output.strip() if code == 0 else ""


def _split_reference(reference: str) -> tuple[str, str]:
    """`cr.yandex/x/pseudex:0.3` → (`cr.yandex/x/pseudex`, `0.3`). A digest
    reference has no tag to move; the port in a registry host is not a tag."""
    if "@" in reference:
        return reference.split("@", 1)[0], ""
    head, _sep, tail = reference.rpartition(":")
    if _sep and "/" not in tail:
        return head, tail
    return reference, ""


def _run_command_from(spec: dict, image: str, image_env: set[str],
                      env_file: str) -> tuple[list[str], list[str]]:
    """The `docker run` that recreates THIS container on ANOTHER image.

    Returns (argv after `docker`, the names of the variables carried over).
    What is carried: name, published ports, mounts (volumes and binds, with
    their mode), the environment set at `docker run` time — the container's
    env minus what the OLD image defined, so the new image's own PATH is not
    overridden by the old one's — `--restart`, `--memory`, `--network`,
    `--ulimit`, `--add-host`, `--user`. The rest of `docker run` is not read:
    an operator who used more runs compose, and compose has `pull` + `up -d`.

    SECRETS DO NOT GO INTO ARGV. The environment carries the vault key and the
    licence key; `-e NAME=VALUE` would put both into `ps`, shell history and
    the ticket the output is pasted into. They travel in an `--env-file` with
    mode 0600 that is deleted the moment the container is created.
    """
    config = spec.get("Config") or {}
    host = spec.get("HostConfig") or {}
    name = str(spec.get("Name") or "").lstrip("/")
    args = ["run", "-d", "--name", name]
    for port, bindings in sorted((host.get("PortBindings") or {}).items()):
        for binding in bindings or []:
            host_ip = str(binding.get("HostIp") or "")
            host_port = str(binding.get("HostPort") or "")
            container_port = port.replace("/tcp", "")
            published = f"{host_ip}:{host_port}:{container_port}" if host_ip else f"{host_port}:{container_port}"
            args += ["-p", published]
    for mount in spec.get("Mounts") or []:
        source = mount.get("Name") if mount.get("Type") == "volume" else mount.get("Source")
        if not source or not mount.get("Destination"):
            continue
        suffix = "" if mount.get("RW", True) else ":ro"
        args += ["-v", f"{source}:{mount['Destination']}{suffix}"]
    carried = sorted(entry.split("=", 1)[0] for entry in (config.get("Env") or [])
                     if entry not in image_env)
    if carried:
        args += ["--env-file", env_file]
    policy = (host.get("RestartPolicy") or {}).get("Name") or ""
    if policy and policy != "no":
        retries = (host.get("RestartPolicy") or {}).get("MaximumRetryCount") or 0
        args += ["--restart", f"{policy}:{retries}" if policy == "on-failure" and retries else policy]
    memory = int(host.get("Memory") or 0)
    if memory:
        args += [f"--memory={memory}"]
    network = str(host.get("NetworkMode") or "")
    if network and network not in ("default", "bridge"):
        args += ["--network", network]
    for limit in host.get("Ulimits") or []:
        args += ["--ulimit", f"{limit.get('Name')}={limit.get('Soft')}:{limit.get('Hard')}"]
    for extra in host.get("ExtraHosts") or []:
        args += ["--add-host", str(extra)]
    if config.get("User"):
        args += ["--user", str(config["User"])]
    args.append(image)
    return args, carried


def _write_env_file(spec: dict, image_env: set[str]) -> str:
    """The run-time environment of the container, 0600, for `--env-file`."""
    config = spec.get("Config") or {}
    lines = [entry for entry in (config.get("Env") or []) if entry not in image_env]
    handle, path = tempfile.mkstemp(prefix="pseudexctl-env-", suffix=".env")
    with os.fdopen(handle, "w", encoding="utf-8") as fh:
        os.fchmod(handle, 0o600)
        fh.write("\n".join(lines) + ("\n" if lines else ""))
    return path


def cmd_upgrade(args, runner: Runner) -> int:
    """Обновить контейнер на другой образ, сохранив том, и уметь вернуться.

    ПОРЯДОК И ЕСТЬ ВСЯ ЗАЩИТА (D-062): pull → probe НОВЫМ образом (ключ
    открывает том, том не из будущего — до того, как что-то остановлено) →
    stop → снимок тома в архив → rename старого → run нового с теми же
    томом, портами, окружением → health. Нездоров: если старый образ ещё
    открывает том (схема не двинулась) — назад на старый контейнер; если схема
    поднята — назад только через снимок, и инструмент печатает команду, а не
    делает вид, что откатил.

    Не для compose: у compose свой `pull` + `up -d`, и контейнер, который он
    создал, пересоздавать мимо него значило бы рассинхронизировать его.
    """
    spec = _inspect(runner, args.container)
    if spec is None and not runner.dry_run:
        print(f"контейнер {args.container} не найден: pseudexctl --container ИМЯ upgrade",
              file=sys.stderr)
        return 2
    spec = spec or {"Name": f"/{args.container}", "Config": {"Image": args.image, "Env": []},
                    "HostConfig": {}, "Mounts": []}
    labels = (spec.get("Config") or {}).get("Labels") or {}
    if "com.docker.compose.project" in labels:
        print(f"{args.container} создан docker compose (проект "
              f"{labels['com.docker.compose.project']}). Обновляйте им же:\n"
              f"  docker compose pull && docker compose up -d\n"
              f"Том и окружение он сохранит сам; снимок тома перед этим — "
              f"pseudexctl backup <файл>.", file=sys.stderr)
        return 2
    current = str((spec.get("Config") or {}).get("Image") or args.image)
    repo, tag = _split_reference(current)
    target = f"{repo}:{args.to}" if args.to else current
    if not args.to and not tag:
        print(f"контейнер запущен по дайджесту ({current}) — плавающего тега нет. "
              f"Назовите версию: pseudexctl upgrade --to 0.4", file=sys.stderr)
        return 2
    print(f"сейчас: {current}\nцель:   {target}")

    code, output = runner.docker(["pull", target], timeout=1800)
    if code != 0 and not runner.dry_run:
        print(f"образ не скачан: {output.strip()[-300:]}\nНичего не тронуто.", file=sys.stderr)
        return 1
    old_id = str(spec.get("Image") or "")
    new_id = _image_id(runner, target)
    if old_id and new_id and old_id == new_id:
        print("уже на этой версии — образ тот же самый. Ничего не тронуто.")
        return 0

    # ПРОБА НОВЫМ ОБРАЗОМ ДО ОСТАНОВКИ: ключ разрешается, том открывается, и
    # он не из будущего (код 2). Отказ здесь стоит ноль секунд простоя.
    code, output = _role(runner, "probe", target, args.volume, _passthrough_env(), read_only=True)
    if code == 2 and not runner.dry_run:
        print(output, end="")
        print("том новее нового образа — обновление отменено, ничего не тронуто.", file=sys.stderr)
        return 1
    if code not in (0, 124, 125, 126, 127) and not runner.dry_run:
        print(output, end="")
        print("новый образ не открывает том текущим ключом — обновление отменено, "
              "ничего не тронуто. Ключ задаётся теми же переменными, что у движка.",
              file=sys.stderr)
        return 1

    code, output = runner.docker(["stop", args.container], timeout=180)
    if code != 0 and not runner.dry_run:
        print(f"не удалось остановить {args.container}: {output.strip()}\nНичего не тронуто.",
              file=sys.stderr)
        return 1

    snapshot = ""
    if not args.no_snapshot:
        snapshot = args.snapshot or f"{args.volume}.pre-{tag or 'digest'}-{args.to or tag}.tgz"
        try:
            mount, name = _archive_mount(snapshot, "rw")
        except ValueError as error:
            print(str(error), file=sys.stderr)
            runner.docker(["start", args.container], timeout=180)
            return 2
        code, output = runner.docker([
            "run", "--rm", "--network", "none", "-v", f"{args.volume}:/data:ro",
            *mount, "--entrypoint", "tar", current,
            "czf", f"/archive/{name}", "-C", "/data", "."], timeout=1800)
        if code != 0 and not runner.dry_run:
            print(f"снимок тома не снят: {output.strip()[-300:]}\nВозвращаю прежний контейнер.",
                  file=sys.stderr)
            runner.docker(["start", args.container], timeout=180)
            return 1
        print(f"снимок тома: {snapshot}")

    old_name = f"{args.container}-old-{tag or 'digest'}"
    code, output = runner.docker(["rename", args.container, old_name], timeout=60)
    if code != 0 and not runner.dry_run:
        print(f"не удалось переименовать {args.container}: {output.strip()}", file=sys.stderr)
        runner.docker(["start", args.container], timeout=180)
        return 1

    image_env = _image_env(runner, old_id or current)
    env_file = _write_env_file(spec, image_env) if not runner.dry_run else "<env-file>"
    try:
        run_args, carried = _run_command_from(spec, target, image_env, env_file)
        if runner.dry_run or runner.verbose:
            print(f"переносится окружение: {', '.join(carried) or '—'}", file=sys.stderr)
        code, output = runner.docker(run_args, timeout=300)
    finally:
        if env_file != "<env-file>":
            os.unlink(env_file)
    if code != 0 and not runner.dry_run:
        print(f"новый контейнер не создан: {output.strip()[-300:]}", file=sys.stderr)
        return _rollback(args, runner, old_name, current, schema_moved=False)

    if _wait_healthy(runner, args.url):
        if not args.keep_old:
            runner.docker(["rm", old_name], timeout=60)
        print(f"обновлено: {current} → {target}. Том сохранён"
              + (f", снимок: {snapshot}" if snapshot else "")
              + ("" if args.keep_old else f"; прежний контейнер удалён")
              + ".")
        return 0

    # НЕЗДОРОВ. Двинулась ли схема — спрашивает СТАРЫЙ образ: если он ещё
    # открывает том, откат свободен; если отвечает 2 — только через снимок.
    _code, tail = runner.docker(["logs", "--tail", "40", args.container], timeout=60)
    print(f"новый контейнер не поднялся за три минуты. Последние строки:\n{tail}", file=sys.stderr)
    runner.docker(["rm", "-f", args.container], timeout=120)
    probe_code, _out = _role(runner, "probe", current, args.volume, _passthrough_env(), read_only=True)
    return _rollback(args, runner, old_name, current, schema_moved=(probe_code == 2), snapshot=snapshot)


def _rollback(args, runner: Runner, old_name: str, current: str, schema_moved: bool,
              snapshot: str = "") -> int:
    """Back to the previous container, or the honest sentence when that is
    not possible. The new container's NAME is freed first either way — a
    half-created one would block the rename."""
    runner.docker(["rm", "-f", args.container], timeout=120)
    if schema_moved:
        print("ОТКАТИТЬ АВТОМАТИЧЕСКИ НЕЛЬЗЯ: новый образ поднял схему тома, и прежний "
              "образ её не откроет. Путь назад — снимок:\n"
              f"  pseudexctl restore {snapshot or '<снимок>'} --yes\n"
              f"  docker rename {old_name} {args.container} && docker start {args.container}\n"
              "Прежний контейнер не удалён, том не тронут дальше.", file=sys.stderr)
        return 1
    runner.docker(["rename", old_name, args.container], timeout=60)
    code, output = runner.docker(["start", args.container], timeout=180)
    if code != 0 and not runner.dry_run:
        print(f"откат: прежний контейнер не поднялся: {output.strip()}", file=sys.stderr)
        return 1
    print(f"откат выполнен: прежний контейнер {args.container} ({current}) запущен снова. "
          f"Причина — в строках выше.", file=sys.stderr)
    return 1


def cmd_doctor(args, runner: Runner) -> int:
    """Собрать всё и сказать, ЧТО СЛОМАНО И ЧТО ДЕЛАТЬ.

    Не «показать состояние»: состояние уже показывают `/status`, `/diagnostics`
    и `probe`, каждый со своей стороны и своими словами. Здесь три источника
    сведены в один вердикт, и у каждой строки есть следующее действие — иначе
    инструмент отвечает на вопрос, которого никто не задавал, вместо того,
    который задают всегда.

    НИ ОДНА ПРОВЕРКА НЕ ПРЕРЫВАЕТ ОСТАЛЬНЫЕ. Врач, замолчавший на первом
    симптоме, хуже отсутствующего: чаще всего сломано именно то, что не
    проверили.
    """
    lines: list[tuple[str, str, str]] = []

    code, output = runner.docker(["inspect", "--format",
                                  "{{.State.Status}} {{.Config.Image}}",
                                  args.container], timeout=60)
    if code != 0:
        lines.append((BAD, f"контейнер {args.container} не найден",
                      "проверьте имя: pseudexctl --container ИМЯ doctor"))
    else:
        state = output.split()[0] if output.split() else "?"
        image = output.split()[1] if len(output.split()) > 1 else "?"
        lines.append((OK if state == "running" else BAD,
                      f"контейнер {state}, образ {image}",
                      "" if state == "running" else "docker logs "
                      f"{args.container} --tail 200 — первая строка скажет почему"))

    status, body = runner.http(f"{args.url}/license", "")
    if status == 200:
        lines.append((OK, "лицензия в порядке", ""))
    elif status == 503:
        lines.append((BAD, "лицензия деградировала — /license отвечает 503",
                      "смотрите grace_left_s в теле; если ноль — оплата или связь"))
    else:
        lines.append((BAD, f"движок не отвечает на {args.url}/license ({status})",
                      "порт опубликован? контейнер запущен?"))

    if not args.token:
        lines.append((WARN, "операторский токен не задан — глубже смотреть нечем",
                      "PSEUDEX_ADMIN_TOKEN=… pseudexctl doctor, или --token"))
    else:
        status, body = runner.http(f"{args.url}/status", args.token)
        if status != 200:
            lines.append((BAD, f"/status ответил {status}",
                          "токен тот? он задаётся контейнеру один раз на все воркеры"))
        else:
            lines += _read_status(body)

    # ТОМ МОНТИРУЕТСЯ ТОЛЬКО НА ЧТЕНИЕ. Докстринг `probe` обещает, что роль
    # ничего не создаёт, но обещание — не механизм: ключ-парольная форма доходит
    # до `vault_key._salt()`, и тот пишет файл соли в чужой том. Диагностика,
    # меняющая то, что диагностирует, уже однажды сгенерировала ключ рядом с
    # данными и объявила весь том неоткрываемым.
    code, output = _role(runner, "probe", args.image, args.volume,
                         _passthrough_env(), read_only=True)
    # ОТКАЗ DOCKER'А — ЭТО НЕ ОТКАЗ ТОМА. 127 — нет docker, 125 — нет образа,
    # 124 — не дождались: любой из них печатался как «том НЕ открывается», самый
    # пугающий вердикт инструмента, про том, который никто не открывал.
    if code == 0:
        lines.append((OK, "том открывается текущим ключом", ""))
    elif code in (124, 125, 126, 127):
        lines.append((WARN, f"проверить том не удалось: {output.strip()[:80]}",
                      "docker в PATH? образ скачан? "
                      "pseudexctl --image ОБРАЗ doctor"))
    else:
        lines.append((BAD, "том НЕ открывается текущим ключом",
                      "pseudexctl probe — он скажет, какой файл и почему"))
    if "ключ лежит рядом с данными" in output:
        lines.append((WARN, "ключ волта лежит в том же томе, что и данные",
                      "кража тома забирает и ключ: PSEUDEX_VAULT_KEY_CMD переносит "
                      "его в ваш менеджер секретов"))
    if "снимки перед миграциями" in output:
        names = [line.split()[0] for line in output.splitlines() if ".pre-" in line]
        lines.append((WARN, f"в томе лежат снимки перед миграциями: {', '.join(names)}",
                      "они весят столько же, сколько стор; удалите, когда новая "
                      "версия поработала и откат не нужен"))

    for mark, what, todo in lines:
        print(f"{_MARK[mark]}  {what}")
        if todo:
            print(f"          -> {todo}")
    broken = [line for line in lines if line[0] == BAD]
    print()
    print("всё в порядке" if not broken else f"проблем: {len(broken)}")
    return 1 if broken else 0


def _day(stamp: object) -> str:
    """unix → ГГГГ-ММ-ДД, по UTC: дата снятия с поддержки — календарная, а не
    момент, и часовой пояс оператора здесь только запутал бы."""
    return time.strftime("%Y-%m-%d", time.gmtime(float(stamp)))


def _read_status(body: str) -> list[tuple[str, str, str]]:
    """Вердикты по телу /status. Отдельно от `cmd_doctor`, потому что это
    единственная часть, которую можно проверить без docker и без движка."""
    try:
        data = json.loads(body or "{}")
    except ValueError:
        return [(BAD, "/status вернул не JSON", "версия образа старше инструмента?")]
    out: list[tuple[str, str, str]] = []

    engine = data.get("engine") or {}
    if not engine.get("assets_loaded", True):
        out.append((BAD, "словари детекции не загружены — /mask отвечает 503",
                    "нет бандла: это не «детекция похуже», это остановка"))

    # ВЕРСИЯ — ПО ВЕРДИКТУ СЕРВЕРА, НЕ ПО ОЩУЩЕНИЮ (D-055). Одна строка в любом
    # случае: «новейшая», «доступна X», или «сервер не сказал» — молчание
    # сервера не значит «новейшая», и тишина тут была бы неверным диагнозом.
    release = engine.get("release") or {}
    version = release.get("version") or engine.get("version") or "?"
    upgrade = release.get("upgrade") or "pseudexctl upgrade"
    licence = data.get("license") or {}
    if licence.get("code") == "unsupported_client":
        out.append((BAD, f"движок {version} больше не обслуживается — сервер лицензий "
                         "отказал в аренде (426)",
                    f"{upgrade}" + (f" — минимальная {release['min_supported']}"
                                    if release.get("min_supported") else "")))
    elif release.get("deprecated_at"):
        until = release.get("sunset_at")
        out.append((WARN, f"движок {version} снят с поддержки"
                          + (f", обслуживается до {_day(until)}" if until else ""),
                    f"{upgrade} — после этой даты сервер лицензий откажет в аренде"))
    elif release.get("running_latest") is False:
        out.append((WARN, f"движок {version}, доступна {release.get('latest')}",
                    upgrade))
    elif release.get("running_latest") is True:
        out.append((OK, f"движок {version} — новейшая", ""))
    else:
        out.append((WARN, f"движок {version} — сервер лицензий не сообщил, есть ли новее",
                    "реестр версий ещё не доехал до сервера, или сервер старше движка"))
    notice = release.get("notice") or {}
    if notice.get("text"):
        mark = BAD if notice.get("severity") == "critical" else WARN
        out.append((mark, f"уведомление о версии: {notice['text']}", notice.get("url", "")))

    memory = engine.get("memory") or {}
    budget = memory.get("worker_mb_budget") or 0
    largest = memory.get("largest_process_mb") or 0
    if budget and largest > budget:
        out.append((WARN, f"крупнейший процесс {largest} МБ при бюджете {budget} МБ",
                    "поднимите лимит памяти или уменьшите PSEUDEX_WORKERS — иначе "
                    "решать будет OOM-killer, а его вердикт это статус 137"))
    if memory.get("limit_mb") is None:
        out.append((WARN, "у контейнера нет лимита памяти",
                    "предполёт в этом случае ничего не проверяет: docker run "
                    "--memory=…"))

    vault = data.get("vault") or {}
    if vault.get("on_disk") == "plaintext":
        out.append((BAD, "настоящие значения лежат в томе ОТКРЫТЫМ ТЕКСТОМ",
                    "кто получил том, снимок диска или бэкап — прочитал всё"))
    elif vault.get("on_disk") == "mixed":
        out.append((WARN, "часть хранилищ ещё открыта — миграция оборвалась",
                    "перезапуск с тем же ключом дошифрует остальные"))

    licence = data.get("license") or {}
    grace = licence.get("grace_left_s")
    if licence.get("state") == "stale" and grace is not None:
        out.append((WARN, f"аренда не продлевается, до остановки {grace} с",
                    "связь до лицензионного сервера или оплата"))
    return out


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="pseudexctl", description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--container", default=os.environ.get("PSEUDEX_CONTAINER", DEFAULT_CONTAINER))
    parser.add_argument("--image", default=os.environ.get("PSEUDEX_IMAGE", DEFAULT_IMAGE))
    parser.add_argument("--volume", default=os.environ.get("PSEUDEX_VOLUME", DEFAULT_VOLUME))
    parser.add_argument("--url", default=os.environ.get("PSEUDEX_URL", DEFAULT_URL))
    parser.add_argument("--token", default=os.environ.get("PSEUDEX_ADMIN_TOKEN", ""),
                        help="операторский токен; по умолчанию из PSEUDEX_ADMIN_TOKEN")
    parser.add_argument("--dry-run", action="store_true",
                        help="напечатать команды, ничего не выполняя")
    parser.add_argument("-v", "--verbose", action="store_true")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("doctor", help="что сломано и что делать").set_defaults(run=cmd_doctor)
    sub.add_parser("probe", help="открывается ли том текущим ключом").set_defaults(run=cmd_probe)
    preflight = sub.add_parser("preflight", help="сколько воркеров влезает в память")
    preflight.add_argument("--memory", default="", help="проверить против другого лимита, например 2g")
    preflight.set_defaults(run=cmd_preflight)
    sub.add_parser("decrypt", help="выгрузить хранилища открытым текстом").set_defaults(run=cmd_decrypt)
    sub.add_parser("diag", help="/diagnostics работающего движка").set_defaults(run=cmd_diag)
    sub.add_parser("metrics", help="/metrics работающего движка").set_defaults(run=cmd_metrics)

    rekey = sub.add_parser("rekey", help="сменить ключ волта")
    rekey.add_argument("--verify", action="store_true",
                       help="доказать, что детокенизация выжила ротацию")
    rekey.add_argument("--start-cmd", default="",
                       help="чем поднимать движок после ротации, например "
                            "'docker compose up -d pseudex'. Обязателен, когда "
                            "ключ задан литералом: docker start воспроизведёт "
                            "СТАРЫЙ ключ")
    rekey.set_defaults(run=cmd_rekey)

    backup = sub.add_parser("backup", help="копия тома в файл")
    backup.add_argument("file")
    backup.add_argument("--force", action="store_true",
                        help="снять копию при работающем движке: копия живой "
                             "базы ОТКРЫВАЕТСЯ и содержит не то")
    backup.set_defaults(run=cmd_backup)

    restore = sub.add_parser("restore", help="восстановить том из файла")
    restore.add_argument("file")
    restore.add_argument("--yes", action="store_true", help="да, перезаписать том")
    restore.set_defaults(run=cmd_restore)

    upgrade = sub.add_parser("upgrade", help="обновить контейнер на другой образ, сохранив том")
    upgrade.add_argument("--to", default="",
                         help="тег назначения (0.4, 0.4.1); без него — тот же тег, что "
                              "у контейнера, заново скачанный (плавающий 0.3 двинется)")
    upgrade.add_argument("--snapshot", default="",
                         help="куда снять архив тома перед обновлением "
                              "(по умолчанию <том>.pre-<старый>-<новый>.tgz)")
    upgrade.add_argument("--no-snapshot", action="store_true",
                         help="не снимать архив тома (снимок схемы внутри тома всё равно будет)")
    upgrade.add_argument("--keep-old", action="store_true",
                         help="не удалять прежний контейнер после успешного подъёма")
    upgrade.set_defaults(run=cmd_upgrade)

    args = parser.parse_args(argv)
    return args.run(args, Runner(args.dry_run, args.verbose))


if __name__ == "__main__":
    raise SystemExit(main())
