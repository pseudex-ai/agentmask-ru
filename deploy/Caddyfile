# TLS, HSTS and the security headers a static front door should own.
# Certificates are obtained and renewed automatically; there is no cron job here
# whose silent failure would expire the site.

{$SITE_HOST} {
	# ACCESS LOG TO A FILE AS WELL AS STDOUT. stdout is what promtail ships to
	# Loki; the file is what fail2ban on the host reads (`bootstrap.sh`, jail
	# `pseudex-web`): scanners and login bruteforce get banned at the packet
	# level, in Docker's DOCKER-USER chain, before Caddy sees the next request.
	# A named logger, so the default stdout one stays.
	log file {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# Django sets its own CSP per response; this removes the header Caddy
		# would otherwise leave for a proxy to guess at.
		-Server
	}

	reverse_proxy storefront:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}

# The licensing server, on the same machine and the same port 443. Caddy
# terminates TLS for this name too (one Let's Encrypt account, one renewal
# loop) and hands plain HTTP to the container. No HSTS preload here: the
# client is a container with an explicit URL, not a browser.
{$LICENSE_HOST} {
	log file {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy license:8443 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}
