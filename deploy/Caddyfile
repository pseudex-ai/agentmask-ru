# TLS, HSTS and the security headers a static front door should own.
# Certificates are obtained and renewed automatically; there is no cron job here
# whose silent failure would expire the site.

{$SITE_HOST} {
	# ACCESS LOG TO A FILE AS WELL AS STDOUT. stdout is what promtail ships to
	# Loki; the file is what fail2ban on the host reads (`bootstrap.sh`, jail
	# `pseudex-web`): scanners and login bruteforce get banned at the packet
	# level, in Docker's DOCKER-USER chain, before Caddy sees the next request.
	# A named logger, so the default stdout one stays.
	log file {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# Django sets its own CSP per response; this removes the header Caddy
		# would otherwise leave for a proxy to guess at.
		-Server
	}

	reverse_proxy storefront:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}

# www → apex, ОТДЕЛЬНЫМ БЛОКОМ. Caddy выдаёт сертификат ровно на те имена, что
# перечислены в адресе сайта: без этой строки `www` получил бы не редирект, а
# ошибку TLS — сертификата для этого имени у него нет, и рукопожатие развалилось
# бы раньше, чем запрос дошёл до storefront. `{uri}` сохраняет путь, поэтому
# https://www.pseudex.ru/detection ведёт на /detection, а не на главную: ссылку
# на документ из письма иначе теряет получатель.
#
# РЕДИРЕКТ, А НЕ ПРОКСИРОВАНИЕ. `PSEUDEX_ALLOWED_HOSTS` — это ровно `SITE_HOST`
# (compose.yml, в трёх сервисах), так что запрос с `Host: www.pseudex.ru`,
# дошедший до Django, получил бы 400 Bad Request. Здесь Caddy отвечает сам, до
# storefront он не доходит. Сертификат на `www` выпускается тем же аккаунтом
# Let's Encrypt и тем же циклом продления, что и для apex-имени, — отдельного
# cron, который может тихо перестать работать, не появляется.
www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

# The licensing server, on the same machine and the same port 443. Caddy
# terminates TLS for this name too (one Let's Encrypt account, one renewal
# loop) and hands plain HTTP to the container. No HSTS preload here: the
# client is a container with an explicit URL, not a browser.
{$LICENSE_HOST} {
	log file {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy license:8443 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}

# Продуктовая аналитика (Rybbit, профиль `analytics`). Тот же Caddy, тот же
# аккаунт Let's Encrypt. Маршруты — как в Caddyfile самого Rybbit: /api/* —
# бэкенд, остальное — интерфейс. Пока профиль выключен, имя отвечает 502 —
# это честнее, чем молчащий счётчик.
#
# ФОРМА ВХОДА ЗДЕСЬ ПОКА СМОТРИТ НАРУЖУ. Следующий шаг — WireGuard на хосте и
# `not remote_ip` на всё, кроме приёма событий (/api/track, /api/script.js,
# /api/replay/*): у приёма событий не может быть закрытого адреса, у формы
# входа — может и должен.
analytics.{$SITE_HOST} {
	log file {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
	encode zstd gzip
	request_body max_size 10MB
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	handle /api/* {
		reverse_proxy rybbit-backend:3001 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		reverse_proxy rybbit-client:3002 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# ── ПОРТАЛ ИДЕНТИЧНОСТИ ──────────────────────────────────────────────────────
#
# Отдельное имя, а не путь на витрине: сессионная кука Authelia даёт доступ ко
# всем внутренним инструментам сразу, и жить она должна на своём домене. Кука
# при этом ставится на общий домен (`session.cookies[].domain`), иначе браузер
# не пошлёт её на `board.` и вход зациклится.
{$AUTH_HOST} {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	reverse_proxy authelia:9091
}

# ── ДОСКА ЗАДАЧ ──────────────────────────────────────────────────────────────
#
# СКРЫТЫЙ ПРЕФИКС `/ops-7f3a` ЗДЕСЬ ТАКАЯ ЖЕ КОНСТАНТА, КАК В СБОРКЕ ФРОНТЕНДА
# (`ARG FRONTEND_PATH` в `deploy/board/Dockerfile.frontend`) И В РЕНДЕРЕ AUTHELIA.
# Разойдутся — ассеты уедут в 404, а редирект после входа — на корень доски.
#
# ПОЧЕМУ ПРЕФИКС, А НЕ ПРОСТО ДОМЕН: это второй слой, обфускация, а не защита —
# дверь здесь Authelia. Посторонний не должен даже знать, что на этом домене
# что-то есть, поэтому всё остальное отвечает 404, а не редиректом.
{$BOARD_HOST} {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	# `route` ЗАДАЁТ ПОРЯДОК, КОТОРЫЙ CADDY САМ НЕ СОХРАНЯЕТ: его встроенный
	# порядок ставит `uri` (перезапись пути) выше `forward_auth`, поэтому
	# `strip_prefix` срезал бы префикс раньше, чем Authelia увидела адрес, и в
	# `X-Original-URL` уехал бы корень — после входа человек попал бы на 404.
	handle /ops-7f3a/api/* {
		route {
			forward_auth authelia:9091 {
				uri /api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
				header_up X-Original-URL {scheme}://{host}{uri}
			}
			uri strip_prefix /ops-7f3a
			reverse_proxy board:3456
		}
	}
	handle /ops-7f3a/* {
		route {
			forward_auth authelia:9091 {
				uri /api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
				header_up X-Original-URL {scheme}://{host}{uri}
			}
			uri strip_prefix /ops-7f3a
			reverse_proxy board-frontend:80
		}
	}
	handle {
		respond 404
	}
}
