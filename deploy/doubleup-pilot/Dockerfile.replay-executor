# Build ONLY with the two-member RAM tar context in test_replay_executor.py --build.
# No repository-root build context, backend source, licensing assets or credentials.
FROM python:3.12-slim-trixie@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9

# Public wheels only; every direct AND transitive dependency is pinned. No resolver
# additions, pip config, network/model SDKs, apt packages or company code.
RUN python -I -m pip --isolated install --no-cache-dir --only-binary=:all: \
      --index-url https://pypi.org/simple --no-deps \
      numpy==2.2.6 pandas==2.2.3 openpyxl==3.1.5 matplotlib==3.10.3 \
      contourpy==1.3.2 cycler==0.12.1 fonttools==4.58.0 kiwisolver==1.4.8 \
      packaging==25.0 pillow==11.2.1 pyparsing==3.2.3 \
      python-dateutil==2.9.0.post0 pytz==2025.2 six==1.17.0 tzdata==2025.2 \
      et-xmlfile==2.0.0 python-docx==1.2.0 lxml==5.4.0 typing_extensions==4.14.0 \
    && python -I -m pip check \
    && mkdir -p /opt /work /mnt \
    && ln -s /work /mnt/data \
    && chmod 0755 /opt /work

COPY --chmod=0644 replay_executor.py /opt/replay_executor.py
USER 1000:1000
WORKDIR /work
ENTRYPOINT ["python", "-I", "-B", "/opt/replay_executor.py", "--bootstrap"]
