# Боевой стенд: скопировать в deploy/.env и заполнить.
#
# Этот файл — единственное место, где живут секреты продакшена, и он НЕ в git.
# Права: chmod 600, владелец — тот же пользователь, что запускает агента.
#
# Почему не секрет-менеджер: на одном хосте он добавляет ещё одну систему,
# которая может лечь, и ещё один секрет (доступ к нему самому), который всё
# равно ляжет в файл рядом. Когда хостов станет больше одного — вернуться к
# вопросу; сейчас это была бы сложность без выигрыша.

# ── обязательное, без него compose не поднимется ────────────────────────────

# Домен витрины и домен лицензионного сервера. Оба указывают на эту машину,
# оба обслуживает Caddy на :443 и сам получает на них сертификаты.
SITE_HOST=pseudex.ru
LICENSE_HOST=license.pseudex.ru

# Версия, которую держит стенд. Пишется АГЕНТОМ при выкатке — руками трогать
# только если выкатываете вручную.
VERSION=1.0.0

POSTGRES_PASSWORD=
# openssl rand -base64 48
PSEUDEX_SECRET_KEY=

# Приватный ключ подписи бандла. ТОТ ЖЕ, с которым собран образ: проверочный
# ключ компилируется внутрь бинарника, и другой сюда не подойдёт.
PSEUDEX_SIGNING_KEY=

# Ключ, которым запечатан блоб тюнинга (base64 32 байт). ТОТ ЖЕ, с которым собран
# образ (build-arg PSEUDEX_TUNING_KEY): сервер кладёт его в каждую аренду, движок
# им открывает свой вкомпилированный тюнинг. Другой сюда не подойдёт — движок
# откажется детектить. Генерация: `openssl rand -base64 32`.
PSEUDEX_TUNING_KEY=

# ── тревоги ─────────────────────────────────────────────────────────────────
# Бот-нотификатор (НЕ тот же, что бот поддержки) и id приватного канала.
# Канал: создать, добавить бота администратором, id узнать через
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
# У канала id отрицательный и начинается с -100.
PSEUDEX_TG_TOKEN=
PSEUDEX_TG_CHAT=
# Как подписывать сообщения. Пригодится, когда появится второй стенд.
PSEUDEX_ENV_NAME=prod

# Админ-токен лицензионного сервера — сторож ходит им в /admin/list.
PSEUDEX_LICENSE_ADMIN_TOKEN=

# ТОКЕН ВИТРИНЫ. Его отсутствие здесь означало, что стенд, поднятый по этому
# образцу, НЕ СТАРТУЕТ: `compose.yml` требует переменную через `:?`. Права у
# него уже витринные — девять ручек из десяти, без каталога абонентов.
PSEUDEX_LICENSE_STOREFRONT_TOKEN=

# ── ПРОФИЛИ — ЗДЕСЬ, А НЕ В КОМАНДНОЙ СТРОКЕ ────────────────────────────────
# Агент выкатывает `docker compose up -d` без флагов, и сервис под профилем,
# который включили один раз руками через `--profile`, он больше не обновляет
# и не считает лишним: Prometheus так и стоял бы на образе первой выкатки.
# Compose читает эту переменную из `.env` сам. Пусто — только основной стек.
#     COMPOSE_PROFILES=observability,support
COMPOSE_PROFILES=

# ── наблюдаемость (профиль observability) ───────────────────────────────────
# Пароль администратора Grafana. Нужен ТОЛЬКО с профилем `observability`.
# Переменная не обязательная (`:-` в compose), потому что compose подставляет
# значения ДО отбора профилей: с `:?` опциональный сервис требовал бы пароль
# при обычном `up -d`. Пустой пароль Grafana не примет и скажет об этом сама.
#
# Полный админский токен лицензионного сервера Prometheus получает ФАЙЛОМ, а не
# переменной: подстановку `${...}` делает сам Compose, и токен лёг бы открытым
# текстом в `docker inspect`. См. docs/operations.md §5.
GRAFANA_PASSWORD=

# ── необязательное ──────────────────────────────────────────────────────────

REGISTRY=cr.yandex/pseudex
# Образ, который витрина показывает клиенту в команде запуска.
CUSTOMER_IMAGE=cr.yandex/pseudex/pseudex:1.0.0
# Адрес сервера лицензий, который витрина ПОДСТАВЛЯЕТ в команду. Пусто — образ
# возьмёт своё вшитое умолчание; заполнено — команда получит `-e ...`.
PSEUDEX_LICENSE_URL=https://license.pseudex.ru

# Путь админки Django. Фиксированный /admin/ — первое, что перебирает сканер;
# смена не безопасность, но убирает фоновый шум, в котором прячется настоящая
# попытка.
ADMIN_PATH=

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Аренда и льгота. Умолчания — сутки и двое суток; трогать только осознанно,
# от них зависит, сколько клиент переживёт наш простой.
LEASE_TTL=86400
GRACE=172800

# ── аварийное ───────────────────────────────────────────────────────────────
# Закрепить версию и ВЫКЛЮЧИТЬ автовыкатку. Нужно ровно тогда, когда что-то
# пошло не так и нужно время подумать, не воюя с агентом, который упорно
# возвращает «правильную» версию. Снять — закомментировать.
# PSEUDEX_PIN=v1.0.0

# ОБЯЗАТЕЛЬНЫ. Без них агент не выкатывает ничего — и это правильно: `.*` здесь
# означало бы «любой аккаунт GitHub», см. deploy/agent.sh. Якорь на тег
# отсекает образ, подписанный из main ручным запуском release.
COSIGN_ISSUER_REGEXP=^https://token\.actions\.githubusercontent\.com$
COSIGN_IDENTITY_REGEXP=^https://github\.com/Isk4R1oT/Obscura/\.github/workflows/release\.yml@refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$

# ── РЕКВИЗИТЫ ПРОДАВЦА ───────────────────────────────────────────────────────
# Без них не рендерятся: страница /requisites (ст. 10 ч. 2 ФЗ «Об информации»
# и ст. 26.1 ЗоЗПП), политика обработки, согласие на обработку и печатная форма
# счёта. Пока пусто — страницы честно говорят, что реквизиты не заполнены, и
# счёт нельзя предъявить к оплате. Это правильный исход, а не поломка.
PSEUDEX_SELLER_NAME=
PSEUDEX_SELLER_INN=
PSEUDEX_SELLER_OGRN=
PSEUDEX_SELLER_ADDRESS=
PSEUDEX_SELLER_EMAIL=
PSEUDEX_SELLER_PHONE=
# КПП у ИП НЕТ — оставить пустым, иначе на счёте появится строка, которой не
# существует, и бухгалтер контрагента вернёт документ.
PSEUDEX_SELLER_KPP=
# Банк — из реквизитов расчётного счёта ИП.
PSEUDEX_SELLER_BANK=
PSEUDEX_SELLER_BIK=
PSEUDEX_SELLER_ACCOUNT=
PSEUDEX_SELLER_CORR_ACCOUNT=
# УСН 6% «Доходы»: НДС не начисляется (ст. 346.11 п. 3 НК).
# В КАВЫЧКАХ: файл читается через `source` в checks.yml, и скобка без кавычек
# — синтаксическая ошибка shell. Проверка была красной с самого появления строки.
PSEUDEX_SELLER_VAT="Без НДС (УСН)"

# --- БОТ ПОДДЕРЖКИ — ОТДЕЛЬНЫЙ от ops-бота выше (docs/decisions.md, 29.08.2026).
# Токен — от @BotFather. Группа — СУПЕРГРУППА операторов (id вида -100…): бот
# в ней администратор, клиенты её не видят. Владелец — ваш telegram id.
PSEUDEX_SUPPORT_BOT_TOKEN=
PSEUDEX_SUPPORT_CHAT=
PSEUDEX_SUPPORT_OWNER=
# Имя бота без @ — попадает на лендинг ссылкой. Пусто = ссылки нет и текст
# честно говорит «почта».
PSEUDEX_SUPPORT_BOT=pseudex_support_bot
