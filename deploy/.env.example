# Боевой стенд: скопировать в deploy/.env и заполнить.
#
# Этот файл — единственное место, где живут секреты продакшена, и он НЕ в git.
# Права: chmod 600, владелец — тот же пользователь, что запускает агента.
#
# Почему не секрет-менеджер: на одном хосте он добавляет ещё одну систему,
# которая может лечь, и ещё один секрет (доступ к нему самому), который всё
# равно ляжет в файл рядом. Когда хостов станет больше одного — вернуться к
# вопросу; сейчас это была бы сложность без выигрыша.

# ── обязательное, без него compose не поднимется ────────────────────────────

# Домен витрины и домен лицензионного сервера. Оба указывают на эту машину,
# оба обслуживает Caddy на :443 и сам получает на них сертификаты.
SITE_HOST=pseudex.ru
LICENSE_HOST=license.pseudex.ru

# Версия, которую держит стенд. Пишется АГЕНТОМ после каждой удачной выкатки
# (и отката) — руками трогать только если выкатываете вручную. До первой
# выкатки строки может не быть: compose из рук оператора тогда откажет с
# «required variable VERSION», и это ожидаемо.
VERSION=1.0.0

POSTGRES_PASSWORD=
# openssl rand -base64 48
PSEUDEX_SECRET_KEY=

# Приватный ключ подписи бандла. ТОТ ЖЕ, с которым собран образ: проверочный
# ключ компилируется внутрь бинарника, и другой сюда не подойдёт.
PSEUDEX_SIGNING_KEY=

# Секрет водяного знака: сервер метит каждую лизу по org, утёкший тюнинг называет
# виновника. ОБЯЗАТЕЛЕН — прод-стек не поднимется с пустым (атрибуция должна быть
# включена). Сгенерировать: `openssl rand -hex 32`.
PSEUDEX_WATERMARK_SECRET=

# Секрет канареек: сервер вплетает в газетиры каждой лизы уникальные фейк-фамилии/
# улицы по org; склонированный из дампа движок маскирует их — и называет виновника
# (licensing/canary.py). ОБЯЗАТЕЛЕН. Сгенерировать: `openssl rand -hex 32`.
# ПРИ АПГРЕЙДЕ существующего стенда задайте ОБА секрета ДО того, как агент подхватит
# новую версию: без них `compose up` падает на интерполяции, откатывается и шлёт
# crit-тревогу каждый тик, пока .env не поправят. make-release-keys.sh генерит оба.
PSEUDEX_CANARY_SECRET=

# ── тревоги ─────────────────────────────────────────────────────────────────
# Бот-нотификатор (НЕ тот же, что бот поддержки) и id приватного канала.
# Канал: создать, добавить бота администратором, id узнать через
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
# У канала id отрицательный и начинается с -100.
PSEUDEX_TG_TOKEN=
PSEUDEX_TG_CHAT=
# Как подписывать сообщения. Пригодится, когда появится второй стенд.
PSEUDEX_ENV_NAME=prod

# Админ-токен лицензионного сервера — сторож ходит им в /admin/list.
PSEUDEX_LICENSE_ADMIN_TOKEN=

# ТОКЕН ВИТРИНЫ. Его отсутствие здесь означало, что стенд, поднятый по этому
# образцу, НЕ СТАРТУЕТ: `compose.yml` требует переменную через `:?`. Права у
# него уже витринные — девять ручек из десяти, без каталога абонентов.
PSEUDEX_LICENSE_STOREFRONT_TOKEN=

# ── ПРОФИЛИ — ЗДЕСЬ, А НЕ В КОМАНДНОЙ СТРОКЕ ────────────────────────────────
# Агент выкатывает `docker compose up -d` без флагов, и сервис под профилем,
# который включили один раз руками через `--profile`, он больше не обновляет
# и не считает лишним: Prometheus так и стоял бы на образе первой выкатки.
# Compose читает эту переменную из `.env` сам. Пусто — только основной стек.
#     COMPOSE_PROFILES=observability,support,analytics
COMPOSE_PROFILES=

# ── наблюдаемость (профиль observability) ───────────────────────────────────
# Пароль администратора Grafana. Нужен ТОЛЬКО с профилем `observability`.
# Переменная не обязательная (`:-` в compose), потому что compose подставляет
# значения ДО отбора профилей: с `:?` опциональный сервис требовал бы пароль
# при обычном `up -d`. Пустой пароль Grafana не примет и скажет об этом сама.
#
# Полный админский токен лицензионного сервера Prometheus получает ФАЙЛОМ, а не
# переменной: подстановку `${...}` делает сам Compose, и токен лёг бы открытым
# текстом в `docker inspect`. См. docs/operations.md §5.
GRAFANA_PASSWORD=

# ── продуктовая аналитика (профиль analytics) ─────────────────────────────
# Rybbit на этой же машине, за нашим Caddy на analytics.$SITE_HOST — DNS-запись
# A на тот же адрес нужна ДО включения профиля, иначе Caddy копит отказы ACME.
# Оба секрета: `openssl rand -hex 32`. Первый — подпись сессий интерфейса
# аналитики, второй — один пароль на её ClickHouse, Postgres и Redis (они не
# смотрят наружу, и три разных пароля здесь — три места, где один из них
# окажется пустым).
RYBBIT_AUTH_SECRET=
RYBBIT_DB_PASSWORD=
# false — пока не создан наш аккаунт на https://analytics.$SITE_HOST/signup;
# потом true и `up -d`, иначе регистрация в аналитику открыта всем.
RYBBIT_DISABLE_SIGNUP=false
# Что грузит ВИТРИНА (и что она пишет о себе на лендинге и в политике —
# текст выводится из режима). off — только серверный счёт визитов, баннера
# нет. full — Rybbit: записи сессий, клики, воронки; баннер согласия
# показывается, потому что режим его включает. HOST — адрес аналитики, KEY —
# site id, который Rybbit показывает после «Add website».
PSEUDEX_ANALYTICS_MODE=off
PSEUDEX_ANALYTICS_HOST=
PSEUDEX_ANALYTICS_KEY=

# ЯНДЕКС.МЕТРИКА. Пусто — счётчик не ставится, и это состояние по умолчанию.
# Номер счётчика (metrika.yandex.ru), только цифры.
#
# ВКЛЮЧЕНИЕ — ЭТО НЕ ОДНА СТРОКА, ХОТЯ ТЕХНИЧЕСКИ ОДНА. Сайт публично обещает
# отсутствие Метрики ПО ИМЕНИ в трёх местах: ответ FAQ на лендинге, текст баннера
# согласия и раздел 9bis политики обработки. Все три выведены из этой настройки и
# перепишутся сами — но проверить их надо глазами, а политику ещё и вычитать:
# это документ, который читает служба безопасности клиента.
#
# И ДВА ПУНКТА В САМОМ СЧЁТЧИКЕ, КОТОРЫЕ КОД НЕ КОНТРОЛИРУЕТ: «Вебвизор, карта
# скроллинга, аналитика форм» и автоматические цели задаются в панели Метрики.
# Вебвизор в коде выключен (`webvisor: false` в `static/analytics.js`), но
# галочку в панели надо снять отдельно — иначе состояние противоречиво, и
# следующий читатель не поймёт, какое из двух главное.
PSEUDEX_METRIKA_ID=

# ── ЯНДЕКС: ДОСТУП К API ────────────────────────────────────────────────────
#
# СЧЁТЧИК ВЫШЕ И ЭТИ ТРИ — ПРО РАЗНОЕ. `PSEUDEX_METRIKA_ID` отвечает «показывать
# ли счётчик посетителю»; здесь — «имеем ли право читать статистику и управлять
# кампаниями». Счётчик может стоять без этих строк, и они могут стоять без него.
#
# ПРИЛОЖЕНИЕ ЗАВОДИТСЯ ОДИН РАЗ: https://oauth.yandex.ru/?dialog=create-client-entry
# («Для доступа к API или отладки»). Источники данных, которые нужны:
#   * Метрика — «Получение статистики, чтение параметров своих и доверенных
#     счётчиков» (metrika:read) и «Загрузка данных» (metrika:write, без него не
#     работает офлайн-конверсия по оплате);
#   * Директ — «Использование API Яндекс Директа» (direct:api).
# Redirect URI — https://oauth.yandex.ru/verification_code: тогда Яндекс
# показывает код на экране, и его отдают команде ниже. Это единственный шаг,
# который требует человека; дальше приложение обновляет токен само.
#
# REFRESH-ТОКЕН — ЭТО ДОСТУП, А НЕ ИДЕНТИФИКАТОР. Он действует, пока владелец
# не отзовёт приложение, и обменивается на access-токен без участия человека.
# Поэтому он лежит здесь (как пароль), а access-токен не лежит нигде: он
# выводится из refresh и живёт в памяти процесса.
#
# ПОЛУЧЕНИЕ (обмен кода на токен, один раз):
#   python3 manage.py yandex_auth --url                  # адрес авторизации
#   python3 manage.py yandex_auth <код> --env-file deploy/.env
# ПРОВЕРКА:
#   python3 manage.py yandex_auth --status
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REFRESH_TOKEN=

# ОТПРАВКА КОНВЕРСИЙ — ОТДЕЛЬНОЕ РЕШЕНИЕ, А НЕ СЛЕДСТВИЕ ТОКЕНА.
#
# ЧТО ЭТОТ ФЛАГ РАЗРЕШАЕТ. Команда `manage.py yandex_conversions` рассказывает
# Метрике о регистрации, активации и оплате — офлайн-конверсиями, потому что
# обе страницы несут секрет (токен активации, лицензионный ключ) и счётчика на
# них нет и быть не может.
#
# ПОЧЕМУ ЭТО НЕ ВКЛЮЧАЕТСЯ ОДНИМ ТОКЕНОМ. Счётчик спрашивает согласие
# баннером, и раздел 9bis политики обещает: «без ответа не загружается ни один
# счётчик». Конверсия уходит С СЕРВЕРА и на выбор посетителя не смотрит:
# отказавшийся «Не считать» всё равно отдал бы в Яндекс факт своей регистрации,
# привязанный к клику по объявлению. Раздел 6 политики называет передачу
# сведений о посещении в Метрику обработкой «с отдельным согласием» — значит
# либо согласие проводится и до конверсий, либо основание меняется и политика
# правится. Это решение Оператора, а не следствие настройки.
#
# ПОКА ФЛАГ ПУСТ, не уходит ничего. `manage.py yandex_conversions --dry-run`
# работает без него и печатает, что ушло бы.
PSEUDEX_YANDEX_CONVERSIONS=

# ТОКЕН МАШИННОГО ДОСТУПА К OPS-API. Открывает только читающие эндпоинты
# `/ops/yandex/*` (статистика Метрики, кампании Директа, состояние интеграции) —
# ни биллинга, ни данных клиентов. Нужен боту и агенту: у них нет ни пароля, ни
# второго фактора, и заводить им staff-аккаунт значило бы выдать весь биллинг
# ради одной сводки. Пусто — машинного доступа нет.
#
#   curl -H "Authorization: Bearer $PSEUDEX_OPS_API_TOKEN" \
#        https://pseudex.ru/<PSEUDEX_ADMIN_PATH>/ops/yandex/status
PSEUDEX_OPS_API_TOKEN=

# ── необязательное ──────────────────────────────────────────────────────────

REGISTRY=cr.yandex/pseudex
# Образ, который витрина показывает клиенту в команде запуска.
CUSTOMER_IMAGE=cr.yandex/pseudex/pseudex:1.0.0
# Адрес сервера лицензий, который витрина ПОДСТАВЛЯЕТ в команду. Пусто — образ
# возьмёт своё вшитое умолчание; заполнено — команда получит `-e ...`.
PSEUDEX_LICENSE_URL=https://license.pseudex.ru

# Путь админки Django. Фиксированный /admin/ — первое, что перебирает сканер;
# смена не безопасность, но убирает фоновый шум, в котором прячется настоящая
# попытка.
ADMIN_PATH=

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Аренда и льгота. Умолчания — сутки и двое суток; трогать только осознанно,
# от них зависит, сколько клиент переживёт наш простой.
LEASE_TTL=86400
GRACE=172800

# ── аварийное ───────────────────────────────────────────────────────────────
# Закрепить версию и ВЫКЛЮЧИТЬ автовыкатку. Нужно ровно тогда, когда что-то
# пошло не так и нужно время подумать, не воюя с агентом, который упорно
# возвращает «правильную» версию. Снять — закомментировать.
# PSEUDEX_PIN=v1.0.0

# ОБЯЗАТЕЛЬНЫ. Без них агент не выкатывает ничего — и это правильно: `.*` здесь
# означало бы «любой аккаунт GitHub», см. deploy/agent.sh. Якорь на тег
# отсекает образ, подписанный из main ручным запуском release.
COSIGN_ISSUER_REGEXP=^https://token\.actions\.githubusercontent\.com$
COSIGN_IDENTITY_REGEXP=^https://github\.com/Isk4R1oT/Obscura/\.github/workflows/release\.yml@refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$

# ── РЕКВИЗИТЫ ПРОДАВЦА ───────────────────────────────────────────────────────
# Без них не рендерятся: страница /requisites (ст. 10 ч. 2 ФЗ «Об информации»
# и ст. 26.1 ЗоЗПП), политика обработки, согласие на обработку и печатная форма
# счёта. Пока пусто — страницы честно говорят, что реквизиты не заполнены, и
# счёт нельзя предъявить к оплате. Это правильный исход, а не поломка.
PSEUDEX_SELLER_NAME=
PSEUDEX_SELLER_INN=
PSEUDEX_SELLER_OGRN=
PSEUDEX_SELLER_ADDRESS=
PSEUDEX_SELLER_EMAIL=
PSEUDEX_SELLER_PHONE=
# КПП у ИП НЕТ — оставить пустым, иначе на счёте появится строка, которой не
# существует, и бухгалтер контрагента вернёт документ.
PSEUDEX_SELLER_KPP=
# Банк — из реквизитов расчётного счёта ИП.
PSEUDEX_SELLER_BANK=
PSEUDEX_SELLER_BIK=
PSEUDEX_SELLER_ACCOUNT=
PSEUDEX_SELLER_CORR_ACCOUNT=
# УСН 6% «Доходы»: НДС не начисляется (ст. 346.11 п. 3 НК).
# В КАВЫЧКАХ: файл читается через `source` в checks.yml, и скобка без кавычек
# — синтаксическая ошибка shell. Проверка была красной с самого появления строки.
PSEUDEX_SELLER_VAT="Без НДС (УСН)"

# --- БОТ ПОДДЕРЖКИ — ОТДЕЛЬНЫЙ от ops-бота выше (docs/decisions.md, 29.08.2026).
# Токен — от @BotFather. Группа — СУПЕРГРУППА операторов (id вида -100…): бот
# в ней администратор, клиенты её не видят. Владелец — ваш telegram id.
PSEUDEX_SUPPORT_BOT_TOKEN=
PSEUDEX_SUPPORT_CHAT=
PSEUDEX_SUPPORT_OWNER=
# Имя бота без @ — попадает на лендинг ссылкой. Пусто = ссылки нет и текст
# честно говорит «почта».
PSEUDEX_SUPPORT_BOT=pseudex_support_bot

# --- эквайринг (ЮKassa) ---------------------------------------------------
# Боевые ключи магазина. Пусто — карта просто не предлагается, счёт по
# реквизитам остаётся: отсутствие эквайринга НЕ должно ронять витрину.
PSEUDEX_YOOKASSA_SHOP_ID=
PSEUDEX_YOOKASSA_SECRET_KEY=
# РУБИЛЬНИК ОТДЕЛЬНО ОТ КЛЮЧЕЙ. Ключи могут быть заданы и одобрены, а карта всё
# ещё скрыта, пока здесь не 1 — так магазин включается одной строкой, без
# пересборки и выката, и так же мгновенно гасится, если что-то пойдёт не так.
PSEUDEX_ACQUIRING_ENABLED=0
