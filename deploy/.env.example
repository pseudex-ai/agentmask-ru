# Боевой стенд: скопировать в deploy/.env и заполнить.
#
# Этот файл — единственное место, где живут секреты продакшена, и он НЕ в git.
# Права: chmod 600, владелец — тот же пользователь, что запускает агента.
#
# Почему не секрет-менеджер: на одном хосте он добавляет ещё одну систему,
# которая может лечь, и ещё один секрет (доступ к нему самому), который всё
# равно ляжет в файл рядом. Когда хостов станет больше одного — вернуться к
# вопросу; сейчас это была бы сложность без выигрыша.

# ── обязательное, без него compose не поднимется ────────────────────────────

# Домен витрины. Тот же, что в сертификате Caddy.
SITE_HOST=pseudex.ru

# Версия, которую держит стенд. Пишется АГЕНТОМ при выкатке — руками трогать
# только если выкатываете вручную.
VERSION=1.0.0

POSTGRES_PASSWORD=
# openssl rand -base64 48
PSEUDEX_SECRET_KEY=

# Приватный ключ подписи бандла. ТОТ ЖЕ, с которым собран образ: проверочный
# ключ компилируется внутрь бинарника, и другой сюда не подойдёт.
PSEUDEX_SIGNING_KEY=

# Ключ, которым запечатан блоб тюнинга (base64 32 байт). ТОТ ЖЕ, с которым собран
# образ (build-arg PSEUDEX_TUNING_KEY): сервер кладёт его в каждую аренду, движок
# им открывает свой вкомпилированный тюнинг. Другой сюда не подойдёт — движок
# откажется детектить. Генерация: `openssl rand -base64 32`.
PSEUDEX_TUNING_KEY=

# ── тревоги ─────────────────────────────────────────────────────────────────
# Бот-нотификатор (НЕ тот же, что бот поддержки) и id приватного канала.
# Канал: создать, добавить бота администратором, id узнать через
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
# У канала id отрицательный и начинается с -100.
PSEUDEX_TG_TOKEN=
PSEUDEX_TG_CHAT=
# Как подписывать сообщения. Пригодится, когда появится второй стенд.
PSEUDEX_ENV_NAME=prod

# Админ-токен лицензионного сервера — сторож ходит им в /admin/list.
PSEUDEX_LICENSE_ADMIN_TOKEN=

# ТОКЕН ВИТРИНЫ. Его отсутствие здесь означало, что стенд, поднятый по этому
# образцу, НЕ СТАРТУЕТ: `compose.yml` требует переменную через `:?`. Права у
# него уже витринные — девять ручек из десяти, без каталога абонентов.
PSEUDEX_LICENSE_STOREFRONT_TOKEN=

# ── необязательное ──────────────────────────────────────────────────────────

REGISTRY=cr.yandex/pseudex
# Образ, который витрина показывает клиенту в команде запуска.
CUSTOMER_IMAGE=cr.yandex/pseudex/pseudex:1.0.0
# Адрес сервера лицензий, который витрина ПОДСТАВЛЯЕТ в команду. Пусто — образ
# возьмёт своё вшитое умолчание; заполнено — команда получит `-e ...`.
PSEUDEX_LICENSE_URL=https://license.pseudex.ru

# Путь админки Django. Фиксированный /admin/ — первое, что перебирает сканер;
# смена не безопасность, но убирает фоновый шум, в котором прячется настоящая
# попытка.
ADMIN_PATH=

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Аренда и льгота. Умолчания — сутки и двое суток; трогать только осознанно,
# от них зависит, сколько клиент переживёт наш простой.
LEASE_TTL=86400
GRACE=172800

# ── аварийное ───────────────────────────────────────────────────────────────
# Закрепить версию и ВЫКЛЮЧИТЬ автовыкатку. Нужно ровно тогда, когда что-то
# пошло не так и нужно время подумать, не воюя с агентом, который упорно
# возвращает «правильную» версию. Снять — закомментировать.
# PSEUDEX_PIN=v1.0.0

# Подпись проверяется по этим шаблонам. Умолчание `.*` принимает любую личность
# из Sigstore и годится, пока публикуем только мы. Когда появится второй
# публикующий — сузить до конкретного репозитория, иначе проверка перестанет
# что-либо доказывать.
# COSIGN_IDENTITY_REGEXP=^https://github\.com/<org>/<repo>/\.github/workflows/release\.yml@refs/tags/v.*$
# COSIGN_ISSUER_REGEXP=^https://token\.actions\.githubusercontent\.com$
