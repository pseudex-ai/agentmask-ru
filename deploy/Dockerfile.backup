# Образ ночного бэкапа: все инструменты ВНУТРИ, ни одного `apk add` в рантайме.
#
# ПОЧЕМУ ЭТО ОТДЕЛЬНЫЙ ОБРАЗ, А НЕ `postgres:17-alpine` С ДОКАЧКОЙ. Так и было,
# и `backup.sh` до сих пор носит следы: базовый образ не несёт `sqlite3`, поэтому
# КАЖДАЯ ночная копия лицензионной базы молча уходила в `cp` живой WAL-базы —
# копию, которая открывается и врёт, — а сторож смотрит только на возраст файла.
# Ту дыру заткнули строкой `apk add` в самом скрипте, и она работает ровно до
# первой ночи без сети: докачка В МОМЕНТ бэкапа означает, что бэкап зависит от
# интернета, которого в аварии может не быть. Инструмент, нужный для спасения,
# обязан лежать рядом заранее.
#
# RESTIC, А НЕ СВОЙ ВЫВОЗ. Здесь стоял самописный скрипт: age-шифрование, aws s3
# cp, локальный учёт отправленного. Он работал и был хуже restic по каждой оси —
# нет дедупликации (тридцать полных дампов вместо процентов от одного), нет
# проверки целостности, нет снапшотов, ретенция через `find -mtime`. Продукт,
# который сам про себя говорит «не изобретаем», не должен изобретать бэкап.
FROM alpine:3.21

# Версия базового образа закреплена, а пакеты — нет: это инструменты, а не
# зависимости продукта, и обновления безопасности здесь нужнее воспроизводимости
# до байта. Слепок всё равно фиксируется дайджестом образа в манифесте релиза.
RUN apk add --no-cache \
        postgresql17-client \
        sqlite \
        restic \
        coreutils \
        findutils \
        tzdata \
    && pg_dump --version && sqlite3 --version && restic version

ENTRYPOINT ["/bin/sh"]
