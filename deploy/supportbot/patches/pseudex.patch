+/**
+ * One Telegram id, three spellings. A text message carries the id as a NUMBER
+ * (`text.ts:72`) and a file message as a STRING (`files.ts:163`), and MongoDB
+ * does not match across types — so one client held two tickets, and the
+ * screenshot they sent «быстрее описания» landed in the second one. Every
+ * lookup goes through here, so the difference cannot decide anything again.
+ */
+export const idVariants = (
+  id: string | number,
+): Array<{ userid: string | number }> => {
+  const seen: Array<string | number> = [];
+  for (const v of [id, String(id), Number(id)] as Array<string | number>) {
+    if (typeof v === 'number' && Number.isNaN(v)) continue;
+    if (!seen.includes(v)) seen.push(v);
+  }
+  return seen.map(userid => ({ userid }));
+};
+
 export async function getTicketByUserId (
   userId: string | number,
   category: string | null
 ) {
   const query = {
-    $or: [{ userid: userId }],
-    ...(category ? { category } : { category: null }),
+    $or: idVariants(userId),
+    ...(category ? { category } : {}),
   };
   const result = await Supportee.findOne(query);
   return result;
