index 0000000..ce029fa
--- /dev/null
+++ b/test/pseudex-regressions.test.ts
@@ -0,0 +1,97 @@
+// РЕГРЕССИИ, КОТОРЫЕ ПРИНЕСЛИ МЫ, А НЕ АПСТРИМ (deploy/supportbot/patches).
+//
+// Каждый тест здесь падает на НЕПАТЧЕННОМ апстриме v5.0.0 — это проверено
+// снятием патча, а не предположением. Смысл файла в том, что ошибки эти были
+// НЕМЫМИ: клиент не получал ответа, а оператор не видел ни ошибки, ни причины.
+// Молчаливый отказ обязан ломать сборку, иначе он вернётся.
+
+// `test/mocks.ts` подключён глобально (setupFiles) и подменяет ../src/db
+// частичной заглушкой — из-за неё тесты самого апстрима в db.test.ts уходят в
+// ветку `else { expect(true).toBe(true) }` и не проверяют ничего. Здесь модуль
+// нужен настоящий.
+jest.unmock('../src/db');
+
+const mockFindOne = jest.fn();
+const mockUpdateMany = jest.fn();
+const mockFindOneAndReplace = jest.fn();
+
+jest.mock('mongoose', () => {
+  const schema: any = jest.fn().mockImplementation(() => ({ plugin: jest.fn() }));
+  schema.Types = { Mixed: 'Mixed', ObjectId: 'ObjectId' };
+  return {
+    connect: jest.fn().mockResolvedValue({}),
+    Schema: schema,
+    Types: { ObjectId: jest.fn() },
+    model: jest.fn().mockReturnValue({
+      // Обёртки, а не ссылки: фабрика jest.mock выполняется раньше, чем
+      // инициализируются const'ы выше, и прямая ссылка упала бы в TDZ.
+      findOne: (...a: unknown[]) => mockFindOne(...a),
+      updateMany: (...a: unknown[]) => mockUpdateMany(...a),
+      findOneAndReplace: (...a: unknown[]) => mockFindOneAndReplace(...a),
+    }),
+    connection: { on: jest.fn() },
+  };
+});
+
+jest.mock('../src/cache', () => ({
+  config: { mongodb_uri: 'mongodb://localhost:27017/test' },
+}));
+
+import * as db from '../src/db';
+
+describe('категория оператора не означает «тикет без категории»', () => {
+  beforeEach(() => jest.clearAllMocks());
+
+  it('поиск по номеру тикета БЕЗ категории не добавляет фильтр по категории', async () => {
+    mockFindOne.mockResolvedValue(null);
+    await db.getTicketById(1, null);
+    const query = mockFindOne.mock.calls[0][0] as Record<string, unknown>;
+    // На апстриме здесь стояло `category: null` — и тикет с категорией
+    // «не существовал», поэтому ответ оператора отбивался как «закрыт».
+    expect(Object.prototype.hasOwnProperty.call(query, 'category')).toBe(false);
+    expect(query.$or).toEqual([{ ticketId: 1 }]);
+  });
+
+  it('поиск по пользователю без категории не сужается до тикетов без категории', async () => {
+    mockFindOne.mockResolvedValue(null);
+    await db.getTicketByUserId(1159307721, null);
+    const query = mockFindOne.mock.calls[0][0] as Record<string, unknown>;
+    expect(Object.prototype.hasOwnProperty.call(query, 'category')).toBe(false);
+  });
+
+  it('когда категория у вызывающего ЕСТЬ, фильтр остаётся', async () => {
+    mockFindOne.mockResolvedValue(null);
+    await db.getTicketById(1, 'Ключ и аренда');
+    const query = mockFindOne.mock.calls[0][0] as Record<string, unknown>;
+    expect(query.category).toBe('Ключ и аренда');
+  });
+});
+
+describe('один telegram id — число и строка одновременно', () => {
+  beforeEach(() => jest.clearAllMocks());
+
+  it('текст даёт число, файл — строку, и оба находят один тикет', async () => {
+    mockFindOne.mockResolvedValue(null);
+    // text.ts ищет числом, files.ts — строкой; Mongo не сравнивает типы, и один
+    // клиент получал два тикета: сообщение и скриншот в разных.
+    await db.getTicketByUserId(1159307721, null);
+    const query = mockFindOne.mock.calls[0][0] as { $or: Array<{ userid: unknown }> };
+    expect(query.$or).toEqual(
+      expect.arrayContaining([{ userid: 1159307721 }, { userid: '1159307721' }]),
+    );
+  });
+
+  it('reopen находит тикет и по userid, и по ticketId в обеих формах', async () => {
+    mockUpdateMany.mockResolvedValue({});
+    await db.reopen(1159307721, '', 'telegram');
+    const filter = mockUpdateMany.mock.calls[0][0] as { $or: unknown[] };
+    expect(filter.$or).toEqual(
+      expect.arrayContaining([
+        { userid: 1159307721 },
+        { userid: '1159307721' },
+        { ticketId: 1159307721 },
+        { ticketId: '1159307721' },
+      ]),
+    );
+  });
+});
