# Раз в минуту. Не чаще: выкатка занимает минуты, а лишние тики упираются в
# замок агента и ничего не делают. Не реже: минута — это верхняя граница
# задержки между «нажал тег» и «поехало», и она должна быть меньше терпения.

[Unit]
Description=pseudex: проверять новый тег раз в минуту

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
# Без этого после перезагрузки все таймеры хоста стартуют в одну секунду.
RandomizedDelaySec=15s
Persistent=true

[Install]
WantedBy=timers.target
