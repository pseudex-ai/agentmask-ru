# Учения по восстановлению.
#
# ПОЧЕМУ ЭТО ОТДЕЛЬНАЯ ЕДИНИЦА, А НЕ СТРОКА В СТОРОЖЕ. Сторож проверяет, что
# файл бэкапа СВЕЖИЙ. Свежий файл и восстановимый файл — разные утверждения, и
# разница между ними обнаруживается ровно один раз: когда восстанавливать уже
# надо. `deploy/backup.sh` говорит это прямым текстом: «бэкап, который никто не
# разворачивал, — это отсутствующий бэкап», — и до сих пор это была фраза, а не
# проверка.
#
# Разворачивается в ОТДЕЛЬНУЮ временную базу, боевую не трогает.

[Unit]
Description=pseudex: развернуть вчерашний бэкап и убедиться, что он живой
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/pseudex/deploy
EnvironmentFile=/opt/pseudex/deploy/.env
ExecStart=/opt/pseudex/deploy/restore-drill.sh
TimeoutStartSec=1800
