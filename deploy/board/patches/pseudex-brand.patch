diff --git a/frontend/src/styles/pseudex-brand.scss b/frontend/src/styles/pseudex-brand.scss
new file mode 100644
index 0000000..2c12b7b
--- /dev/null
+++ b/frontend/src/styles/pseudex-brand.scss
@@ -0,0 +1,161 @@
+// ─────────────────────────────────────────────────────────────────────────────
+// pseudex — брендовый слой. Единственное место, где меняется внешний вид.
+//
+// Палитра и метрики — ровно те же токены, что у сайта и локального интерфейса
+// (`storefront/static/site.css`): один бренд, одна таблица цветов. Значения
+// продублированы здесь потому, что фронтенд Vikunja собирается отдельно от
+// Django и общий CSS подключить не может; расхождение ловится глазами на стенде.
+//
+// СЛОЙ ПЕРЕОПРЕДЕЛЯЕТ И СВЕТЛУЮ, И ТЁМНУЮ ТЕМУ ОДИНАКОВО. Продукт тёмный, и
+// переключатель темы в настройках Vikunja не должен возвращать чужой светлый
+// вид — иначе «наш» интерфейс зависит от того, что выбрал браузер.
+// ─────────────────────────────────────────────────────────────────────────────
+
+:root,
+:root.dark {
+  color-scheme: dark;
+
+  // Поверхности
+  --grey-50: #141417;
+  --grey-50-hsl: 240, 12%, 8%;
+  --grey-100: #17171a;
+  --grey-100-hsl: 240, 7%, 9.6%;
+  --grey-200: #1c1c20;
+  --grey-200-hsl: 240, 6%, 11.8%;
+  --grey-300: #232329;
+  --grey-400: #5c5c66;
+  --grey-500: #8f8e99;
+  --grey-500-hsl: 240, 5%, 58%;
+  --grey-600: #a9a8b3;
+  --grey-700: #cfced6;
+  --grey-800: #e8e7ec;
+  --grey-900: #ffffff;
+
+  --white: #1c1c20;
+  --white-bis: #1c1c20;
+  --black: #e8e7ec;
+  --background: #17171a;
+
+  --site-background: #17171a;
+  --content-background: #1c1c20;
+  --card-background-color: #1c1c20;
+  --input-background-color: #1c1c20;
+  --input-disabled-background-color: #17171a;
+  --table-background-color: #1c1c20;
+
+  // Границы: у нас 1px и никаких теней
+  --border: #2b2b31;
+  --border-light: #232329;
+  --border-hover: #3d3d45;
+  --card-border-color: #2b2b31;
+  --input-border-color: #2b2b31;
+  --shadow: none;
+  --box-shadow: none;
+
+  // Текст
+  --text: #e8e7ec;
+  --text-strong: #ffffff;
+  --text-light: #8f8e99;
+  --text-2: #cfced6;
+  --text-invert: #17171a;
+
+  // Акцент
+  --primary-h: 258deg;
+  --primary-s: 63%;
+  --primary-l: 77%;
+  --primary: #b3a0ea;
+  --primary-hsl: 258, 63%, 77%;
+  --primary-invert: #17171a;
+  --link: #b3a0ea;
+  --link-hover: #cec0f2;
+  --link-visited: #b3a0ea;
+
+  // Статусы
+  --success: #93cfaa;
+  --success-hsl: 145, 38%, 69%;
+  --warning: #dcbd85;
+  --warning-hsl: 38, 55%, 69%;
+  --danger: #e08a8a;
+  --danger-hsl: 0, 58%, 71%;
+  --info: #b3a0ea;
+
+  // Радиусы: прямой угол, как на сайте
+  --radius-small: 0;
+  --radius: 0;
+  --radius-large: 0;
+  --radius-rounded: 0;
+}
+
+html {
+  background: var(--site-background);
+}
+
+// Типографика: текст — Inter, интерфейс — моноширинный, как у нас.
+h1, h2, h3, h4, h5, h6,
+.vikunja-font,
+.navbar,
+.menu,
+.button,
+.button span,
+.tag,
+.label,
+input,
+select,
+textarea,
+.dropdown-item,
+.tooltip {
+  font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
+}
+
+h1, h2, h3, h4, h5, h6 {
+  letter-spacing: -.02em;
+}
+
+// Кнопки — те же, что на сайте: моноширинный капс, тонкая рамка, без заливки.
+.button {
+  text-transform: uppercase;
+  letter-spacing: .1em;
+  font-size: .78rem;
+  font-weight: 600;
+  border-radius: 0;
+}
+
+.button.is-primary {
+  background: var(--primary);
+  color: var(--primary-invert);
+  border-color: var(--primary);
+}
+
+.button.is-primary:hover {
+  background: var(--link-hover);
+  border-color: var(--link-hover);
+}
+
+// Поля ввода: тёмная панель и акцентная рамка в фокусе — как в кабинете.
+input.input,
+textarea,
+.select select {
+  background: var(--panel, #1c1c20);
+  border-color: var(--border);
+  color: var(--text);
+}
+
+input.input:focus,
+textarea:focus,
+.select select:focus {
+  border-color: var(--primary);
+  box-shadow: 0 0 0 1px var(--primary);
+}
+
+a {
+  color: var(--link);
+}
+
+a:hover {
+  color: var(--link-hover);
+}
+
+::selection {
+  background: var(--primary);
+  color: var(--site-background);
+}
