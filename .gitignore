# Python
.venv/
__pycache__/
*.pyc

# Local state / generated artifacts (reproducible from make_*.py)
*.db
*.db-shm
*.db-wal
*.db.lock
# The vault key a run generates beside its database when nothing supplies one.
# It is the key to that developer's own store and it is not a repository
# artefact — but the reason it is listed is the other direction: a key committed
# once stays in the history, and this one opens personal data.
pseudex-vault.key
pseudex-vault.salt
proxy.log
used_pii.txt
dirty.json
holdout*.json
dataset.json
# Адресный набор порождается на ЗАДАННОМ зерне — смысл в том, чтобы зерно
# было свежим, а не в том, чтобы набор лежал в истории.
addr_*.json
stress.json

# Local stand secrets. `deploy/local.sh` generates both and caches them because
# the signing key is compiled into the locally built image — a fresh one would
# force a rebuild on every run. Neither belongs in the repository: a private key
# in git is wrong even when it only signs bundles for a developer's own image.
deploy/.local-signing-key
deploy/.local-tuning-key
# Токены админки лицензионного сервера локального стенда.
deploy/.local-tokens
deploy/.local-tuning-key
deploy/.local-admin
# Полный админский токен для скрейпа Prometheus: он кладётся файлом именно
# потому, что переменная окружения видна в `docker inspect`, — и закоммитить
# его было бы тем же самым, только навсегда.
deploy/secrets/

# Tooling
.playwright-mcp/
.thumbnail
render-check-*.png

# Secrets / local env
.env
.env.*
!.env.example

# e2e stand artefacts — all generated by e2e/gates.py from nothing.
prototype/e2e/certs/
prototype/e2e/faketime/
prototype/e2e/cosign/
prototype/e2e/registry-auth/
prototype/e2e/reports/

# IDE
.idea/

# Live-axis run artefacts. Each holds real tool arguments out of the corpus and a
# spend ledger, and both are per-run facts about a machine rather than about the
# benchmark — the reproducible part is the case id list, which the report prints.
prototype/bench/agentpii2/live/runs/

# Собранные корпуса бенчмарков: детерминированы семенем и пересобираются
# `build.py`, как и остальные наборы проекта. 15 МБ JSON в истории — это
# 15 МБ, которые никто не читает и которые расходятся с генератором при
# первой же правке семейства. Лестница ярусов рядом остаётся: она мелкая и
# она ПИН, то есть именно то, что должно быть неизменным.
prototype/bench/agentpii2/corpus.json
prototype/bench/agentpii3/corpus.json
.claude/worktrees/
deploy/.local-env.sh
deploy/.env.seller
